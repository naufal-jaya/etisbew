---
import SiteIcons from "../components/SiteIcons.astro";
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import AboutOverlay from "../components/AboutOverlay.astro";
import MembersSection from "../components/MembersSection.astro";
import HistorySection from "../components/HistorySection.astro";
import PostsSection from "../components/PostsSection.astro";
import Footer from "../components/Footer.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteIcons />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>IPB University IEEE Student Branch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Inter:wght@100..900&family=Press+Start+2P&family=Silkscreen:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Inter", sans-serif;
      }
      @media (max-width: 767px) {
        /* Reserve the height available while browser toolbars are expanded. */
        #section-hero {
          height: 100svh;
        }
      }
    </style>
  </head>
  <body class="bg-black text-white antialiased">
    <SmoothScroll />
    <main class="relative">
      <!-- Hero section stays sticky in the background -->
      <div
        id="section-hero"
        data-lead-section="hero"
        class="sticky top-0 h-screen w-full z-0"
      >
        <Hero />
      </div>

      <!-- AboutOverlay scrolls up over the Hero -->
      <AboutOverlay />

      <!-- Partners & Milestones Section -->
      <HistorySection />

      <!-- Members Showcase Section -->
      <MembersSection />

      <!-- Posts Section (empty white section following screen height) -->
      <PostsSection />

      <!-- Footer from dev branch -->
      <Footer />
    </main>
  </body>
</html>
