---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import AboutOverlay from '../components/AboutOverlay.astro';
import MembersSection from '../components/MembersSection.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IPB University IEEE Student Branch</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Press+Start+2P&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>
<body class="bg-black text-white antialiased">
  <main class="relative">
    <!-- Hero section stays sticky in the background -->
    <div class="sticky top-0 h-screen w-full">
      <Hero />
    </div>

    <!-- AboutOverlay scrolls up over the Hero -->
    <AboutOverlay />
    
    <!-- Members Showcase Section -->
    <MembersSection />
  </main>
</body>
</html>
