---
import { responsiveImage } from "../sanity/image";
import "../styles/global.css";
import PostCard from "../components/PostCard.astro";
import PostHeader from "../components/PostHeader.astro";
import Footer from "../components/Footer.astro";
import { getFeaturedPosts, getAllPosts, getAllCategories, type PostItem, type PostCategory } from '../data/posts';

const [featuredPosts, allPosts, categories] = await Promise.all([
  getFeaturedPosts(),
  getAllPosts(),
  getAllCategories(),
]);


---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Posts - IPB University IEEE Student Branch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Inter:wght@100..900&family=Press+Start+2P&family=Silkscreen:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Inter", sans-serif;
      }

      /* Featured Carousel Styles */
      :root {
        --posts-card-gap: 16px;
      }
      .featured-row {
        gap: var(--posts-card-gap);
        aspect-ratio: 1835 / 590;
        min-height: 220px;
        max-height: 480px;
      }
      .featured-card {
        flex: 404 1 0%;
        min-width: 0;
        height: 100%;
        transition: flex 0.65s cubic-bezier(0.25, 1, 0.5, 1);
      }
      .featured-card.is-active {
        flex: 1027 1 0%;
      }
      .featured-card .featured-info {
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.35s ease, transform 0.35s ease;
      }
      .featured-card.is-active .featured-info {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 0.18s;
      }
      .featured-card .featured-progress-bar {
        width: 0%;
        transition: none;
      }

      /* Mobile: Single full-width card with smooth cross-fade rotation */
      @media (max-width: 639px) {
        .featured-row {
          aspect-ratio: 2 / 1;
          min-height: 150px;
          max-height: 190px;
          position: relative;
        }
        .featured-card {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          flex: none;
          opacity: 0;
          pointer-events: none;
          transform: scale(0.98);
          transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out;
          z-index: 1;
        }
        .featured-card.is-active {
          opacity: 1;
          pointer-events: auto;
          transform: scale(1);
          z-index: 5;
        }
        .featured-card .featured-info {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 639px) {
        #posts-grid { gap: 0; }
      }

      .featured-info h3 {
        overflow: hidden;
        max-height: 2.5em;
        overflow-wrap: anywhere;
      }

      /* Hide horizontal scrollbar */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body class="bg-white text-black antialiased">
    <!-- Outer container with global padding -->
    <main class="w-full px-4 sm:px-6 md:px-10 lg:px-16 py-4 sm:py-8 md:py-12">
      <!-- Inner max-width wrapper -->
      <div class="w-full max-w-6xl mx-auto flex flex-col justify-center">
        <PostHeader backHref="/" backLabel="Home" listing />



        <!-- Featured Row Carousel -->
        <section class="mb-4 sm:mb-6">
          <div id="featured-row" class="featured-row flex w-full overflow-hidden" data-active-index="1">
            {featuredPosts.map((post, idx) => (
              <div
                class={`featured-card group relative overflow-hidden bg-neutral-900 cursor-pointer ${idx === 1 ? 'is-active' : ''}`}
                data-card-index={idx}
                data-slug={post.slug}
                role="button"
                tabindex="0"
                aria-label={post.title}
              >
                <img
                  {...responsiveImage(post.image, "(max-width: 767px) 90vw, 60vw")}
                  alt={post.title}
                  class="absolute inset-0 w-full h-full object-cover object-center scale-105 group-hover:scale-100 transition-transform duration-700"
                  loading={idx === 1 ? 'eager' : 'lazy'}
                />
                <div class="absolute inset-x-0 bottom-0 h-3/5 bg-gradient-to-t from-black/90 via-black/45 to-transparent pointer-events-none"></div>

                <div class="featured-info absolute inset-x-0 bottom-0 p-3 sm:p-5 md:p-7 text-white z-10 pointer-events-none">
                  <h3 class="text-sm sm:text-lg md:text-xl lg:text-2xl font-bold leading-tight mb-1 md:mb-2 line-clamp-2 max-w-2xl drop-shadow-md">
                    {post.title}
                  </h3>
                  <p class="text-[11px] sm:text-xs md:text-sm text-neutral-300 font-normal drop-shadow-sm truncate">
                    {post.type} by {post.author}
                  </p>
                </div>

                <div class="featured-progress-track absolute inset-x-0 bottom-0 h-1 bg-black/40 z-20 overflow-hidden">
                  <div class="featured-progress-bar h-full bg-white/90 w-0"></div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Dynamic Category Navigation & Filter -->
        <nav class="border-b border-black mb-1 sm:mb-6 pb-2" aria-label="Post categories">
          <ul class="flex w-full min-w-0 flex-nowrap overflow-x-auto overscroll-x-contain touch-pan-x gap-2 sm:gap-3 text-xs sm:text-sm font-medium no-scrollbar items-center" id="category-filter-list">
            {categories.map((cat, idx) => {
              const isActive = idx === 0;
              const isAll = cat.slug === 'all';
              const bgColor = isAll ? '#000000' : cat.color;

              return (
                <li class="shrink-0">
                  <button
                    type="button"
                    class={`category-tab px-3 py-2 sm:py-1 transition-all duration-200 cursor-pointer font-medium ${
                      isActive
                        ? 'is-active ring-1 ring-black/20 font-semibold shadow-sm text-white'
                        : 'text-neutral-700 hover:text-black hover:bg-neutral-100'
                    }`}
                    data-cat-slug={cat.slug}
                    data-bg-color={bgColor}
                    style={isActive ? `background-color: ${bgColor}; color: #ffffff !important;` : ''}
                  >
                    {cat.title}
                  </button>
                </li>
              );
            })}
          </ul>
        </nav>

        <!-- Post Grid (3 Columns) -->
        <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {allPosts.map((post) => <PostCard post={post} />)}

          <!-- Empty State Message when filtering -->
          <div id="no-posts-msg" class="hidden col-span-full py-16 text-center text-neutral-500 text-sm">
            <p class="font-medium text-base text-neutral-700 mb-1">No posts found</p>
            <p class="text-xs text-neutral-500">There are currently no published posts in this category.</p>
          </div>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Carousel & Filtering Scripts -->
    <script>
      // 1. Featured Carousel Logic
      function setupFeaturedCarousel() {
        const row = document.getElementById('featured-row');
        if (!row) return;

        const cards = Array.from(row.querySelectorAll<HTMLElement>('.featured-card'));
        if (cards.length < 2) return;

        const DURATION_MS = 7000;
        let currentIndex = 1;
        let timerStartTime = 0;
        let animFrameId: number | null = null;
        let isPaused = false;
        let elapsedBeforePause = 0;

        function setActive(index: number) {
          currentIndex = (index + cards.length) % cards.length;
          row.dataset.activeIndex = String(currentIndex);

          cards.forEach((card, idx) => {
            const bar = card.querySelector<HTMLElement>('.featured-progress-bar');
            if (idx === currentIndex) {
              card.classList.add('is-active');
              if (bar) bar.style.width = '0%';
            } else {
              card.classList.remove('is-active');
              if (bar) bar.style.width = '0%';
            }
          });

          startProgress(0);
        }

        function startProgress(startElapsed: number) {
          if (animFrameId) cancelAnimationFrame(animFrameId);
          timerStartTime = performance.now() - startElapsed;

          function step(now: number) {
            if (isPaused) return;
            const elapsed = now - timerStartTime;
            const progress = Math.min(1, elapsed / DURATION_MS);
            const activeCard = cards[currentIndex];
            const bar = activeCard?.querySelector<HTMLElement>('.featured-progress-bar');

            if (bar) bar.style.width = `${(progress * 100).toFixed(1)}%`;

            if (progress >= 1) {
              setActive(currentIndex + 1);
            } else {
              animFrameId = requestAnimationFrame(step);
            }
          }
          animFrameId = requestAnimationFrame(step);
        }

        cards.forEach((card, idx) => {
          card.addEventListener('click', () => {
            if (currentIndex !== idx) {
              elapsedBeforePause = 0;
              setActive(idx);
            } else {
              const slug = card.getAttribute('data-slug');
              if (slug) {
                window.location.href = `/posts/${slug}`;
              }
            }
          });
        });

        // Touch swipe support for mobile
        let touchStartX = 0;
        let touchEndX = 0;

        row.addEventListener('touchstart', (e) => {
          if (e.touches && e.touches.length > 0) {
            touchStartX = e.touches[0].clientX;
          }
        }, { passive: true });

        row.addEventListener('touchend', (e) => {
          if (e.changedTouches && e.changedTouches.length > 0) {
            touchEndX = e.changedTouches[0].clientX;
            const diffX = touchEndX - touchStartX;
            if (Math.abs(diffX) > 40) {
              elapsedBeforePause = 0;
              if (diffX < 0) {
                setActive(currentIndex + 1);
              } else {
                setActive(currentIndex - 1);
              }
            }
          }
        }, { passive: true });

        row.addEventListener('mouseenter', () => {
          isPaused = true;
          elapsedBeforePause = performance.now() - timerStartTime;
          if (animFrameId) cancelAnimationFrame(animFrameId);
        });

        row.addEventListener('mouseleave', () => {
          if (isPaused) {
            isPaused = false;
            startProgress(elapsedBeforePause);
          }
        });

        setActive(currentIndex);
      }

      // 2. Interactive Category Filter Logic (Integrated with Sanity Backend & always white text)
      function setupCategoryFilter() {
        const tabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
        const cards = document.querySelectorAll<HTMLElement>('.post-grid-card');
        const noMsg = document.getElementById('no-posts-msg');
        if (!tabs.length || !cards.length) return;

        function applyFilter(targetSlug: string, updateUrl: boolean = true) {
          let activeTab: HTMLButtonElement | null = null;

          tabs.forEach((t) => {
            const catSlug = t.getAttribute('data-cat-slug') || 'all';
            if (catSlug === targetSlug) {
              activeTab = t;
            }
            t.classList.remove('is-active', 'ring-1', 'ring-black/20', 'font-semibold', 'shadow-sm', 'text-white');
            t.classList.add('text-neutral-700', 'hover:text-black', 'hover:bg-neutral-100');
            t.style.backgroundColor = '';
            t.style.color = '';
          });

          // Fallback to 'all' if category slug not found
          if (!activeTab) {
            activeTab = tabs[0];
            targetSlug = activeTab.getAttribute('data-cat-slug') || 'all';
          }

          if (activeTab) {
            const bg = activeTab.getAttribute('data-bg-color') || '#000000';
            activeTab.classList.add('is-active', 'ring-1', 'ring-black/20', 'font-semibold', 'shadow-sm', 'text-white');
            activeTab.classList.remove('text-neutral-700', 'hover:text-black', 'hover:bg-neutral-100');
            activeTab.style.backgroundColor = bg;
            activeTab.style.color = '#ffffff'; // ALWAYS white font color when selected
          }

          let visibleCount = 0;
          cards.forEach((card) => {
            const cardCat = card.getAttribute('data-category-slug');
            if (targetSlug === 'all' || cardCat === targetSlug) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (noMsg) {
            noMsg.classList.toggle('hidden', visibleCount > 0);
          }

          if (updateUrl && typeof window !== 'undefined') {
            const url = new URL(window.location.href);
            if (targetSlug === 'all') {
              url.searchParams.delete('category');
            } else {
              url.searchParams.set('category', targetSlug);
            }
            window.history.replaceState({}, '', url.toString());
          }
        }

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const targetSlug = tab.getAttribute('data-cat-slug') || 'all';
            applyFilter(targetSlug, true);
          });
        });

        // Sync with URL query parameter on page load (e.g. ?category=activities)
        const urlParams = new URLSearchParams(window.location.search);
        const queryCategory = urlParams.get('category');
        if (queryCategory) {
          applyFilter(queryCategory, false);
        }
      }

      function initPostsPage() {
        setupFeaturedCarousel();
        setupCategoryFilter();
      }

      initPostsPage();
      document.addEventListener('astro:page-load', initPostsPage);
    </script>
  </body>
</html>
