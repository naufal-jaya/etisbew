---
import "../../styles/global.css";
import { featuredPosts, recentPosts } from '../../data/posts';

// Fungsi ini memberi tahu Astro rute/URL apa saja yang harus dibuat
export async function getStaticPaths() {
  // Gabungkan semua data
  const allPosts = [...featuredPosts, ...recentPosts];
  
  return allPosts.map((post) => {
    // Membuat URL yang ramah (slug) dari judul artikel. 
    // Contoh: "Hello World" -> "hello-world"
    const slug = post.title.toLowerCase().replace(/[^a-zA-Z0-9]+/g, '-');
    
    return {
      params: { slug }, // URL target
      props: { post },  // Data yang dikirim ke halaman ini
    };
  });
}

// Ambil data post yang dilempar dari getStaticPaths
const { post } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} - IPB University IEEE Student Branch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Inter:wght@100..900&display=swap" rel="stylesheet" />
    <style>
      body { font-family: "Inter", sans-serif; }
    </style>
  </head>
  <body class="bg-white text-black antialiased">
    <main class="w-full px-4 sm:px-6 md:px-10 lg:px-16 py-8 md:py-12">
      <div class="w-full max-w-4xl mx-auto flex flex-col">
        
        <!-- Header: Back Arrow -->
        <header class="mb-10 mt-2">
          <a href="/posts" class="flex items-center gap-3 hover:opacity-75 transition-opacity duration-200 w-fit text-neutral-600" aria-label="Go back to News">
            <span class="text-xl sm:text-2xl font-light">&larr;</span>
            <span class="text-sm md:text-base font-medium">Back to News</span>
          </a>
        </header>

        <!-- Article Header -->
        <div class="mb-8">
          <span class="bg-[#d4ed31] px-3 py-1 text-xs font-bold uppercase tracking-wider text-black inline-block mb-4">
            {post.type}
          </span>
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-6">
            {post.title}
          </h1>
          
          <!-- Gunakan justify-between untuk memisahkan posisi ke kiri dan kanan -->
          <div class="flex justify-between items-center text-sm text-gray-500 pb-6">
            <span class="font-medium text-black">By {post.author}</span>
            <span>Published on 1st August 2026</span> 
          </div>
        </div>

        <!-- Featured Image -->
        <div class="w-full aspect-video bg-neutral-100 mb-10 overflow-hidden">
          <img src={post.image} alt={post.title} class="w-full h-full object-cover" />
        </div>

        <!-- Article Content -->
        <article class="prose max-w-none text-gray-800 leading-relaxed text-sm sm:text-base">
          <!-- Merender isi konten artikel. Pastikan kamu menambahkan field `content` di file data/posts.ts kamu -->
          {post.content ? (
            <div set:html={post.content}></div>
          ) : (
            <p>
              This is a placeholder content for <strong>{post.title}</strong>. To show the real text, add a <code>content</code> property (string or HTML) to this post's object inside your <code>src/data/posts.ts</code> file.
            </p>
          )}
        </article>

      </div>
    </main>
  </body>
</html>