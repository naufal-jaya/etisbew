---
import 'lenis/dist/lenis.css';
---

<script>
  import Lenis from 'lenis';

  // Global reference
  declare global {
    interface Window {
      lenis?: Lenis;
    }
  }

  // 1. Initialize Lenis for fluid, responsive inertial scrolling
  const lenis = new Lenis({
    duration: 0.95,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    orientation: 'vertical',
    gestureOrientation: 'vertical',
    smoothWheel: true,
    wheelMultiplier: 1.05,
    touchMultiplier: 1.25,
    infinite: false,
    autoRaf: false,
    prevent: (node) => {
      // Allow native/custom horizontal dragging or scrolling inside tracks without Lenis interference
      return Boolean(
        node.closest('[data-lenis-prevent]') ||
        node.closest('.members-draggable-track')
      );
    },
  });

  window.lenis = lenis;

  // Run Lenis in RAF loop
  function raf(time: number) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }
  requestAnimationFrame(raf);

  // 2. In-Flight Magnetic Landing Engine
  // Eliminates delayed post-stop snapping completely.
  // When a user scrolls, the deceleration curve is smoothly steered in-flight
  // to land directly and precisely on the section anchor with zero pause or jerk.
  let isGuiding = false;
  let scrollDirection: 1 | -1 = 1; // 1 = down, -1 = up
  let landingTimer: ReturnType<typeof setTimeout> | null = null;

  // Immediately cancel any active auto-glide so new user inputs never fight against ongoing movement
  function cancelGuiding() {
    if (isGuiding) {
      isGuiding = false;
      lenis.scrollTo(lenis.actualScroll, { immediate: true });
    }
    if (landingTimer) {
      clearTimeout(landingTimer);
      landingTimer = null;
    }
  }

  // Compute all target section positions in absolute document scroll coordinates
  function getLeadTargets(): number[] {
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-lead-section]'));
    const viewportHeight = window.innerHeight;
    const targets: number[] = [0]; // Hero is always top: 0

    sections.forEach((section) => {
      const type = section.dataset.leadSection;
      if (type === 'hero') return;

      const rect = section.getBoundingClientRect();
      const topY = Math.round(rect.top + window.scrollY);
      targets.push(topY);

      // If a section is taller than the screen, allow docking at its bottom
      const height = section.offsetHeight;
      if (height > viewportHeight + 150) {
        const bottomY = Math.round(topY + height - viewportHeight);
        targets.push(bottomY);
      }
    });

    // Also include document bottom (maxScroll) so scrolling down to footer docks smoothly
    const maxScroll = Math.max(0, document.documentElement.scrollHeight - viewportHeight);
    if (maxScroll > 0) {
      targets.push(maxScroll);
    }

    // Sort ascending & deduplicate points within 20px
    const sorted = Array.from(new Set(targets)).sort((a, b) => a - b);
    const filtered: number[] = [];
    for (const pos of sorted) {
      if (filtered.length === 0 || pos - filtered[filtered.length - 1] > 20) {
        filtered.push(pos);
      }
    }
    return filtered;
  }

  // Seamlessly steers the ongoing scroll deceleration curve into the destination section
  function guideInFlight() {
    if (isGuiding) return;

    // Do not interrupt if the members division detail drawer is open and the user is inspecting it
    const drawerOpen = document.querySelector('#division-drawer.is-open') || document.querySelector('#members-drawer.is-open');
    const membersSec = document.getElementById('members-section');
    if (drawerOpen && membersSec) {
      const rect = membersSec.getBoundingClientRect();
      if (rect.top <= 120 && rect.bottom >= window.innerHeight - 120) {
        return;
      }
    }

    const targets = getLeadTargets();
    if (targets.length < 2) return;

    const currentY = Math.round(window.scrollY);
    const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

    // If resting at extreme top or bottom, nothing to lead
    if (currentY <= targets[0] + 5 || currentY >= maxScroll - 5) return;

    // Locate the current interval in targets
    let i = 0;
    for (let k = 0; k < targets.length - 1; k++) {
      if (currentY >= targets[k] && currentY < targets[k + 1]) {
        i = k;
        break;
      }
      if (k === targets.length - 2 && currentY >= targets[k + 1]) {
        i = k + 1;
      }
    }

    const vel = lenis.velocity;
    if (Math.abs(vel) > 0.05) {
      scrollDirection = vel > 0 ? 1 : -1;
    }

    const projectedY = (lenis as any).targetScroll ?? (currentY + vel * 140);
    let destination = targets[i];

    if (scrollDirection === 1) {
      // Moving DOWN
      if (i + 1 < targets.length) {
        // Check if fast flick skips to a further section
        if (projectedY > targets[i + 1] + 160) {
          let bestIdx = i + 1;
          let minDiff = Math.abs(projectedY - targets[i + 1]);
          for (let k = i + 2; k < targets.length; k++) {
            const diff = Math.abs(projectedY - targets[k]);
            if (diff < minDiff) {
              minDiff = diff;
              bestIdx = k;
            }
          }
          destination = targets[bestIdx];
        } else {
          // Standard downward scroll: land cleanly on next section
          // (Only stay if accidental micro-nudge < 18px and virtually zero velocity)
          if (Math.abs(currentY - targets[i]) < 18 && Math.abs(vel) < 0.04) {
            destination = targets[i];
          } else {
            destination = targets[i + 1];
          }
        }
      } else {
        destination = targets[targets.length - 1];
      }
    } else {
      // Moving UP
      const prevIdx = (currentY > targets[i] + 18) ? i : Math.max(0, i - 1);
      if (projectedY < targets[prevIdx] - 160) {
        let bestIdx = prevIdx;
        let minDiff = Math.abs(projectedY - targets[prevIdx]);
        for (let k = prevIdx - 1; k >= 0; k--) {
          const diff = Math.abs(projectedY - targets[k]);
          if (diff < minDiff) {
            minDiff = diff;
            bestIdx = k;
          }
        }
        destination = targets[bestIdx];
      } else {
        // Standard upward scroll: land cleanly on previous section
        destination = targets[prevIdx];
      }
    }

    if (Math.abs(currentY - destination) <= 5) return;

    // Glide in-flight into the destination section
    isGuiding = true;
    const dist = Math.abs(currentY - destination);
    const duration = Math.min(0.85, Math.max(0.6, 0.5 + (dist / window.innerHeight) * 0.35));

    lenis.scrollTo(destination, {
      duration,
      easing: (t: number) => 1 - Math.pow(1 - t, 3), // Responsive cubic ease-out
      lock: false,
      onComplete: () => {
        isGuiding = false;
      },
    });
  }

  // Intercept user inputs to cancel ongoing glide and schedule in-flight guidance
  window.addEventListener('wheel', (e) => {
    if (e.target && (e.target as Element).closest?.('.members-draggable-track, [data-lenis-prevent]')) {
      return;
    }

    cancelGuiding();
    if (Math.abs(e.deltaY) > 2) {
      scrollDirection = e.deltaY > 0 ? 1 : -1;
    }

    if (landingTimer) clearTimeout(landingTimer);
    landingTimer = setTimeout(() => {
      guideInFlight();
    }, 70);
  }, { passive: true });

  window.addEventListener('touchstart', () => {
    cancelGuiding();
  }, { passive: true });

  window.addEventListener('touchmove', () => {
    cancelGuiding();
  }, { passive: true });

  window.addEventListener('touchend', () => {
    if (landingTimer) clearTimeout(landingTimer);
    landingTimer = setTimeout(() => {
      guideInFlight();
    }, 80);
  }, { passive: true });

  window.addEventListener('pointerdown', (e) => {
    if (e.target && !(e.target as Element).closest('button, a, input, select')) {
      cancelGuiding();
    }
  }, { passive: true });

  window.addEventListener('keydown', (e) => {
    if (['ArrowDown', 'PageDown', ' '].includes(e.key)) {
      cancelGuiding();
      scrollDirection = 1;
      if (landingTimer) clearTimeout(landingTimer);
      landingTimer = setTimeout(() => {
        guideInFlight();
      }, 40);
    } else if (['ArrowUp', 'PageUp'].includes(e.key)) {
      cancelGuiding();
      scrollDirection = -1;
      if (landingTimer) clearTimeout(landingTimer);
      landingTimer = setTimeout(() => {
        guideInFlight();
      }, 40);
    } else if (e.key === 'Home') {
      cancelGuiding();
      lenis.scrollTo(0, { duration: 0.8 });
    } else if (e.key === 'End') {
      cancelGuiding();
      lenis.scrollTo('bottom', { duration: 0.8 });
    }
  }, { passive: true });

  // Monitor velocity updates
  lenis.on('scroll', (e: { scroll: number; velocity: number; direction: number }) => {
    if (Math.abs(e.velocity) > 0.05) {
      scrollDirection = e.direction >= 0 ? 1 : -1;
    }
  });
</script>
