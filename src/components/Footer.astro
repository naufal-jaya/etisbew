---
const currentYear = new Date().getFullYear();
---

<footer class="bg-deep-navy text-slate-300 py-10 px-6 md:px-10 border-t border-slate-800 relative z-20">
  <!-- Background Pattern -->
  <div class="absolute inset-0 circuit-pattern opacity-5 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-12 relative z-10">
    <!-- Logo & Description -->
    <div class="space-y-6 lg:col-span-2 lg:pr-12">
      <div class="flex items-center gap-3 text-white">
        <img
          src="/images/layout/Logo_IEEE_IPB_Icon.png"
          alt="IEEE Student Branch IPB University Logo"
          width="40"
          height="40"
          class="w-10 h-10 object-contain"
          loading="lazy"
        />
        <div class="flex flex-col justify-center">
          <span class="text-xl font-bold leading-none tracking-tight">
            IPB University
          </span>
          <span class="text-sm font-medium opacity-90 leading-tight">
            IEEE Student Branch
          </span>
        </div>
      </div>
      <p class="text-sm leading-relaxed text-slate-400 max-w-xs">
        Empowering students through technology and innovation at IPB
        University.
      </p>
    </div>

    <!-- Quick Links -->
    <div class="space-y-6">
      <h3 class="text-white text-lg font-semibold">Quick Links</h3>
      <nav class="flex flex-col gap-4">
        <a
          class="text-slate-400 hover:text-blue-500 transition-colors text-sm"
          href="/"
        >
          Home
        </a>
        <a
          class="text-slate-400 hover:text-blue-500 transition-colors text-sm"
          href="/about"
        >
          About
        </a>
        <a
          class="text-slate-400 hover:text-blue-500 transition-colors text-sm"
          href="/news"
        >
          News
        </a>
      </nav>
    </div>

    <!-- Media Social -->
    <div class="space-y-6">
      <h3 class="text-white text-lg font-semibold">Media Social</h3>
      <div class="flex gap-4">
        <!-- Instagram -->
        <a
          class="text-slate-400 hover:text-blue-500 transition-colors"
          href="https://instagram.com/ieeesbipb"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
          </svg>
        </a>
        <!-- LinkedIn -->
        <a
          class="text-slate-400 hover:text-blue-500 transition-colors"
          href="https://www.linkedin.com/company/ieeesbipb"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
          </svg>
        </a>
        <!-- TikTok -->
        <a
          class="text-slate-400 hover:text-blue-500 transition-colors"
          href="https://www.tiktok.com/@ieeesbipb"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path>
          </svg>
        </a>
        <!-- Medium -->
        <a
          class="text-slate-400 hover:text-blue-500 transition-colors"
          href="https://ieeesbipb.medium.com/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Medium"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Contact Us -->
    <div class="space-y-6">
      <h3 class="text-white text-lg font-semibold">Contact Us</h3>

      <div class="flex flex-col gap-4">
        <div class="flex items-start gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="text-white w-5 h-5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <div>
            <div class="text-white font-medium text-sm">Email</div>
            <a
              href="mailto:ieee-student@apps.ipb.ac.id"
              class="text-slate-400 hover:text-blue-500 transition-colors text-xs break-all"
            >
              ieee-student@apps.ipb.ac.id
            </a>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="text-white w-5 h-5 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <div>
            <div class="text-white font-medium text-sm">Location</div>
            <div class="text-slate-400 text-xs leading-relaxed">
              Hosted by Computer Science
              <br />
              IPB University
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Footer -->
  <div class="max-w-7xl mx-auto mt-8 pt-5 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-slate-500 relative z-10">
    <div>
      © {currentYear} IEEE Student Branch IPB University. All rights
      reserved.
    </div>
    <div>by Tech and Information IEEE SB IPB</div>
  </div>
</footer>
