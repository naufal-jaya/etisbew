  /* When card is active (video playing), hide the division text */
  .card-division-label {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .member-card.is-active .card-division-label {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(10px);
  }

  /* Division Drawer Smooth Grid Expansion */
  .division-drawer {
