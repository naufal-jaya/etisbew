    image: "/foto-CnM.jpeg",
    video: "/cnm.mov",
  },
  {
    id: "r2-4",
    divisionId: "edu",
    division: "Education",
    image: "/foto-edu.jpeg",
    video: "/edu.mov",
  },
  {
    id: "r2-5",
    divisionId: "external",
