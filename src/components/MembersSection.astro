  },
];

const initialRow2Members: MemberCard[] = [
  {
    id: "r2-1",
    divisionId: "infor",
    division: "Tech n Information",
    image: "/foto-infor.jpeg",
    video: "/infor.webm",
  },
  {
    id: "r2-2",
    divisionId: "hr",
    division: "Human Resources",
    image: "/foto-hr.jpeg",
    video: "/hr.webm",
  },
  {
    id: "r2-3",
    divisionId: "cnm",
    division: "Creative n Marketing",
    image: "/foto-CnM.jpeg",
    video: "/cnm.webm",
  },
  {
    id: "r2-4",
    divisionId: "edu",
    division: "Education",
    image: "/foto-edu.jpeg",
    video: "/edu.webm",
  },
  {
    id: "r2-5",
    divisionId: "external",
    division: "External Relations",
    image: "/foto-external.jpeg",
    video: "/external.webm",
  },
  {
    id: "r2-6",
    divisionId: "executives",
    division: "Executives",
    image: "/foto-bph.jpeg",
    video: "/bph.webm",
  },
];

// Helpers to match and normalize Sanity CMS division data
function getCanonicalDivisionId(rawId?: string, rawName?: string): string | null {
  const id = (rawId || "").trim().toLowerCase();
  const name = (rawName || "").trim().toLowerCase();

  if (id === "hr" || name.includes("human")) return "hr";
  if (id === "cnm" || name.includes("creative") || name.includes("marketing")) return "cnm";
  if (id === "edu" || name.includes("education")) return "edu";
  if (id === "ext" || id === "external" || name.includes("external")) return "external";
  if (id === "inf" || id === "infor" || name.includes("tech") || name.includes("information") || name.includes("infor")) return "infor";
  if (id === "bph" || id === "exe" || id === "executives" || name.includes("executive") || name.includes("bph")) return "executives";

  if (id && divisionsData[id]) return id;

  return null;
}

function formatNameLines(name: string): [string, string] | [string] {
  const words = name.trim().split(/\s+/);
  if (words.length <= 1) return [name];
  if (words.length === 2) return [words[0], words[1]];
  if (words.length === 3) return [`${words[0]} ${words[1]}`, words[2]];
  const mid = Math.ceil(words.length / 2);
  return [words.slice(0, mid).join(" "), words.slice(mid).join(" ")];
}

function formatLinkedInUrl(linkedin?: string): string {
  if (!linkedin) return "";
  const trimmed = linkedin.trim();
  if (!trimmed) return "";
  if (trimmed.startsWith("http://") || trimmed.startsWith("https://")) {
    return trimmed;
  }
  const clean = trimmed.replace(/^[@/]+/, "").replace(/^linkedin\.com\/in\//, "");
  return `https://www.linkedin.com/in/${clean}`;
}

const DIVISIONS_QUERY = `*[_type == "division"] {
  id,
  name,
  description,
  groupPhoto,
  coverPhotos[],
  members[] {
    name,
    role,
    photo,
    linkedin
  }
}`;

const resolvedDivisions: Record<string, DivisionDetail> = { ...divisionsData };

if (isSanityConfigured) {
  try {
    const sanityDivisions = await sanityClient.fetch(DIVISIONS_QUERY);
    if (Array.isArray(sanityDivisions) && sanityDivisions.length > 0) {
      for (const div of sanityDivisions) {
        const canonicalId = getCanonicalDivisionId(div.id, div.name);
        if (canonicalId && resolvedDivisions[canonicalId]) {
          const fallback = divisionsData[canonicalId];

          // Use Sanity members if non-empty, otherwise use current replacement
          let members: DivisionMember[] = fallback.members;
          if (Array.isArray(div.members) && div.members.length > 0) {
            const parsedMembers = div.members
              .filter((m: any) => m && (m.name || m.role || m.photo))
              .map((m: any) => ({
                name: m.name?.trim() || "Member",
                role: m.role?.trim() || "",
                image: urlForImage(m.photo) || "/dummy-avatar.svg",
                linkedin: formatLinkedInUrl(m.linkedin),
              }));

            if (parsedMembers.length > 0) {
              members = parsedMembers;
            }
          }

          const hasName = Boolean(div.name && div.name.trim());
          const name = hasName ? div.name.trim() : fallback.name;
          const nameLines = hasName ? formatNameLines(name) : fallback.nameLines;
          const hasDesc = Boolean(div.description && div.description.trim());
          const description = hasDesc ? div.description.trim() : fallback.description;
          const groupPhotoUrl = urlForImage(div.groupPhoto);
          const groupPhoto = groupPhotoUrl || fallback.groupPhoto;

          // Resolve coverPhotos array for alternating marquee cards
          const coverPhotos: string[] = [];
          if (Array.isArray(div.coverPhotos) && div.coverPhotos.length > 0) {
            for (const img of div.coverPhotos) {
              const url = urlForImage(img);
              if (url) coverPhotos.push(url);
            }
          }

          resolvedDivisions[canonicalId] = {
            ...fallback,
            name,
            nameLines,
            shortName: name,
            description,
            groupPhoto,
            groupCaption: `${name} Team 2024/2025`,
            coverPhotos: coverPhotos.length > 0 ? coverPhotos : undefined,
            members,
          };
        }
      }
    }
  } catch (err) {
    console.warn("Could not fetch divisions from Sanity CMS, using fallback data:", err);
  }
}

const NUM_CYCLES = 4;

// Dynamically bind division photo and name to marquee cards, using coverPhotos alternately across cycles
const row1Track = Array.from({ length: NUM_CYCLES }).flatMap((_, cycleIdx) =>
  initialRow1Members.map((card) => {
    const div = resolvedDivisions[card.divisionId];
    // If multiple coverPhotos exist, pick alternately based on cycle
    // Fallback: coverPhotos -> groupPhoto -> local card.image
    const photos = div?.coverPhotos && div.coverPhotos.length > 0
      ? div.coverPhotos
      : (div?.groupPhoto ? [div.groupPhoto] : [card.image]);

    const image = photos[cycleIdx % photos.length];

    return {
      ...card,
      id: `${card.id}-c${cycleIdx}`,
      division: div?.shortName || div?.name || card.division,
      image,
    };
  })
);

const row2Track = Array.from({ length: NUM_CYCLES }).flatMap((_, cycleIdx) =>
  initialRow2Members.map((card) => {
    const div = resolvedDivisions[card.divisionId];
    const photos = div?.coverPhotos && div.coverPhotos.length > 0
      ? div.coverPhotos
      : (div?.groupPhoto ? [div.groupPhoto] : [card.image]);

    // Offset by 1 so Row 2 displays an alternate photo from Row 1
    const image = photos[(cycleIdx + 1) % photos.length];

    return {
      ...card,
      id: `${card.id}-c${cycleIdx}`,
      division: div?.shortName || div?.name || card.division,
      image,
    };
  })
);
---

<section
