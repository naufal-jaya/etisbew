    divisionId: "executives",
    division: "Executives",
    image: "/foto-bph.jpeg",
    video: "/bph.mov",
  },
];

// Helpers to match and normalize Sanity CMS division data
function getCanonicalDivisionId(rawId?: string, rawName?: string): string | null {
  const id = (rawId || "").trim().toLowerCase();
  const name = (rawName || "").trim().toLowerCase();

  if (id === "hr" || name.includes("human")) return "hr";
  if (id === "cnm" || name.includes("creative") || name.includes("marketing")) return "cnm";
  if (id === "edu" || name.includes("education")) return "edu";
  if (id === "ext" || id === "external" || name.includes("external")) return "external";
  if (id === "inf" || id === "infor" || name.includes("tech") || name.includes("information") || name.includes("infor")) return "infor";
  if (id === "bph" || id === "exe" || id === "executives" || name.includes("executive") || name.includes("bph")) return "executives";

  if (id && divisionsData[id]) return id;

  return null;
}

function formatNameLines(name: string): [string, string] | [string] {
  const words = name.trim().split(/\s+/);
  if (words.length <= 1) return [name];
  if (words.length === 2) return [words[0], words[1]];
  if (words.length === 3) return [`${words[0]} ${words[1]}`, words[2]];
  const mid = Math.ceil(words.length / 2);
  return [words.slice(0, mid).join(" "), words.slice(mid).join(" ")];
}

function formatLinkedInUrl(linkedin?: string): string {
  if (!linkedin) return "";
  const trimmed = linkedin.trim();
  if (!trimmed) return "";
  if (trimmed.startsWith("http://") || trimmed.startsWith("https://")) {
    return trimmed;
  }
  const clean = trimmed.replace(/^[@/]+/, "").replace(/^linkedin\.com\/in\//, "");
  return `https://www.linkedin.com/in/${clean}`;
}

const DIVISIONS_QUERY = `*[_type == "division"] {
  id,
  name,
  description,
  groupPhoto,
  coverPhotos[],
  members[] {
    name,
    role,
    photo,
    linkedin
  }
}`;

const resolvedDivisions: Record<string, DivisionDetail> = { ...divisionsData };

if (isSanityConfigured) {
  try {
    const sanityDivisions = await sanityClient.fetch(DIVISIONS_QUERY);
    if (Array.isArray(sanityDivisions) && sanityDivisions.length > 0) {
      for (const div of sanityDivisions) {
        const canonicalId = getCanonicalDivisionId(div.id, div.name);
        if (canonicalId && resolvedDivisions[canonicalId]) {
          const fallback = divisionsData[canonicalId];

          // Use Sanity members if non-empty, otherwise use current replacement
          let members: DivisionMember[] = fallback.members;
          if (Array.isArray(div.members) && div.members.length > 0) {
            const parsedMembers = div.members
              .filter((m: any) => m && (m.name || m.role || m.photo))
              .map((m: any) => ({
                name: m.name?.trim() || "Member",
                role: m.role?.trim() || "",
                image: urlForImage(m.photo) || "/dummy-avatar.svg",
                linkedin: formatLinkedInUrl(m.linkedin),
              }));

            if (parsedMembers.length > 0) {
              members = parsedMembers;
            }
          }

          const hasName = Boolean(div.name && div.name.trim());
          const name = hasName ? div.name.trim() : fallback.name;
          const nameLines = hasName ? formatNameLines(name) : fallback.nameLines;
          const hasDesc = Boolean(div.description && div.description.trim());
          const description = hasDesc ? div.description.trim() : fallback.description;
          const groupPhotoUrl = urlForImage(div.groupPhoto);
          const groupPhoto = groupPhotoUrl || fallback.groupPhoto;

          // Resolve coverPhotos array for alternating marquee cards
          const coverPhotos: string[] = [];
          if (Array.isArray(div.coverPhotos) && div.coverPhotos.length > 0) {
            for (const img of div.coverPhotos) {
              const url = urlForImage(img);
              if (url) coverPhotos.push(url);
            }
          }

          resolvedDivisions[canonicalId] = {
            ...fallback,
            name,
            nameLines,
            shortName: name,
            description,
            groupPhoto,
            groupCaption: `${name} Team 2024/2025`,
            coverPhotos: coverPhotos.length > 0 ? coverPhotos : undefined,
            members,
          };
        }
      }
    }
  } catch (err) {
    console.warn("Could not fetch divisions from Sanity CMS, using fallback data:", err);
  }
}

const NUM_CYCLES = 4;

// Dynamically bind division photo and name to marquee cards, using coverPhotos alternately across cycles
const row1Track = Array.from({ length: NUM_CYCLES }).flatMap((_, cycleIdx) =>
  initialRow1Members.map((card) => {
    const div = resolvedDivisions[card.divisionId];
    // If multiple coverPhotos exist, pick alternately based on cycle
    // Fallback: coverPhotos -> groupPhoto -> local card.image
    const photos = div?.coverPhotos && div.coverPhotos.length > 0
      ? div.coverPhotos
      : (div?.groupPhoto ? [div.groupPhoto] : [card.image]);

    const image = photos[cycleIdx % photos.length];

    return {
      ...card,
      id: `${card.id}-c${cycleIdx}`,
      division: div?.shortName || div?.name || card.division,
      image,
    };
  })
);

const row2Track = Array.from({ length: NUM_CYCLES }).flatMap((_, cycleIdx) =>
  initialRow2Members.map((card) => {
    const div = resolvedDivisions[card.divisionId];
    const photos = div?.coverPhotos && div.coverPhotos.length > 0
      ? div.coverPhotos
      : (div?.groupPhoto ? [div.groupPhoto] : [card.image]);

    // Offset by 1 so Row 2 displays an alternate photo from Row 1
    const image = photos[(cycleIdx + 1) % photos.length];

    return {
      ...card,
      id: `${card.id}-c${cycleIdx}`,
      division: div?.shortName || div?.name || card.division,
      image,
    };
  })
);
---

<section
  class="relative z-20 w-full min-h-screen min-h-[100dvh] bg-black select-none flex flex-col justify-stretch p-0 m-0"
  id="members-section"
  data-lead-section="members"
  aria-label="Meet Our People"
>
  <!-- Sticky Section Title (initial position: top-8 md:top-12, sticks until half of Row 1's height) -->
  <div
    class="pointer-events-none z-30 w-full text-center relative pt-8 md:pt-12 h-[calc(22vh+4rem)] md:h-[calc(30dvh+6rem)] -mb-[calc(22vh+4rem)] md:-mb-[calc(30dvh+6rem)]"
  >
    <div
      class="sticky top-8 md:top-12 inline-block text-center whitespace-nowrap"
    >
      <h2 class="pixel-heading relative inline-block text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-wider text-white">
        <span class="pixel-heading-duplicate absolute top-[0.05em] -left-[0.05em] select-none pointer-events-none text-white" aria-hidden="true">
          Meet Our People!
        </span>
        <span class="pixel-heading-main relative text-white">
          Meet Our People!
        </span>
      </h2>
    </div>
  </div>

  <!-- Row 1: Scrolling Right (->) -->
  <div class="marquee-row relative w-full h-[42vh] min-h-[260px] sm:h-[52vh] sm:min-h-[320px] md:h-[60dvh] md:min-h-[380px] flex-shrink-0 overflow-hidden flex items-stretch p-0 m-0">
    <div class="marquee-track marquee-track-right flex h-full w-max p-0 m-0">
      {row1Track.map((member, i) => (
        <div
          class="member-card relative h-full aspect-[15/19] flex-shrink-0 cursor-pointer overflow-hidden p-0 m-0 group border-0 outline-none"
          data-member-id={member.id}
          data-division-id={member.divisionId}
          data-division={member.division}
          data-video={member.video}
          data-track-index={i}
          role="button"
          tabindex="0"
          aria-label={`Lihat divisi ${member.division}`}
        >
          <!-- Photo layer -->
          <img
            src={member.image}
            alt={`${member.division} photo`}
            width="594"
            height="781"
            loading="lazy"
            decoding="async"
            class="card-photo absolute inset-0 w-full h-full object-cover select-none pointer-events-none border-0 outline-none"
          />

          <!-- Video layer (hidden by default, shown on click, no borders) -->
          <video
            class="card-video absolute inset-0 w-full h-full object-cover select-none pointer-events-none opacity-0 border-0 outline-none"
            src={member.video}
            loop
            muted
            playsinline
            preload="none"
          ></video>

          <!-- Gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent pointer-events-none"></div>

          <!-- Bottom Division Label (disappears when video is playing) -->
          <div class="card-division-label absolute bottom-3 left-3 right-3 z-10 select-none pointer-events-none transition-all duration-300">
            <span class="text-white text-lg sm:text-xl md:text-2xl drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)] block">
              {member.division}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Division Detail Showcase Drawer (opens between Row 1 and Row 2) - Size: 1918x367.36px -->
  <div
    id="division-drawer"
    class="division-drawer w-full bg-white text-black relative z-30 shadow-[0_25px_60px_rgba(0,0,0,0.5)] border-y border-neutral-200"
  >
    <div class="division-drawer-inner relative w-full overflow-hidden">


      {Object.values(resolvedDivisions).map((division) => (
        <div
          class="division-panel hidden w-full max-w-[1918px] mx-auto min-h-0 lg:h-[300px] flex items-center px-4 sm:px-10 md:px-12 lg:px-16 box-border"
          data-panel-id={division.id}
        >
          <div class="flex flex-col lg:flex-row items-start lg:items-center gap-2 w-full h-full py-4 box-border">
            
            <!-- Left Column: Division Title, Description & Badge -->
            <div class="w-full lg:w-[280px] xl:w-[320px] flex-shrink-0 flex flex-col justify-center h-full py-1">
              <div>
                <h3 class="text-2xl sm:text-4xl lg:text-5xl font-black text-black tracking-tight leading-[0.93] mb-2">
