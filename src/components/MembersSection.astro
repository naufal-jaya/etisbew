                    <!-- Member overlay gradient / vignette -->
                    <div class="member-overlay absolute inset-0 pointer-events-none rounded-none"></div>

                    <!-- Bottom Text & LinkedIn Link -->
                    <div class="member-info-container absolute bottom-3.5 left-3.5 right-3.5 z-10 select-none flex flex-col justify-end">
                      <h4 class="member-name text-xs sm:text-sm font-bold text-white leading-tight drop-shadow-md pointer-events-none" title={member.name}>
                        {member.name}
                      </h4>

                      <!-- Normal Role: visible when NOT blurred -->
                      <p class="member-role text-xs sm:text-sm text-neutral-300 font-medium leading-tight mt-1 line-clamp-2 pointer-events-none">
                        <span class="md:hidden">{member.role.trim().split(/\s+/)[0]}</span>
