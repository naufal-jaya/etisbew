                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>

              <!-- Draggable Cards Track -->
              <div
                class="members-draggable-track flex items-center gap-3 sm:gap-4 overflow-x-auto select-none cursor-grab active:cursor-grabbing py-1 pl-4 sm:pl-16 pr-4 no-scrollbar h-[172px] sm:h-[196px] md:h-[270px]"
                data-lenis-prevent
              >
                <!-- Group Photo Card (Exact 415x257px on desktop, proportional on mobile, sharp corners: rounded-none, no text, no hover effect) -->
                <div class="group-photo-card relative flex-shrink-0 w-[216px] sm:w-[280px] md:w-[415px] h-[156px] sm:h-[180px] md:h-[257px] rounded-none overflow-hidden bg-neutral-900 border-0 shadow-sm">
                  <img
                    {...responsiveImage(division.groupPhoto, "(max-width: 639px) 216px, (max-width: 767px) 280px, 415px", undefined, 100)}
                    alt={division.groupCaption}
                    class="w-full h-full object-cover select-none pointer-events-none rounded-none"
                    loading="lazy"
                  />
                </div>

                <!-- Member Cards (Exact 185x257px on desktop, proportional on mobile, sharp corners: rounded-none, click to blur & show LinkedIn) -->
                {division.members.map((member) => (
                  <div
                    class="member-profile-card relative flex-shrink-0 w-[112px] sm:w-[128px] md:w-[185px] h-[156px] sm:h-[180px] md:h-[257px] rounded-none overflow-hidden bg-neutral-900 cursor-pointer border-0 select-none shadow-sm"
                    data-member-name={member.name}
                    role="button"
                    tabindex="0"
                    aria-label={`${member.name}, ${member.role}`}
                  >
                    <!-- Member photo with blur transition -->
                    <img
                      {...responsiveImage(member.image, "(max-width: 639px) 112px, (max-width: 767px) 128px, 185px", [160, 280, 370, 560], 100)}
                      alt={member.name}
