  id="members-section"
  data-lead-section="members"
  aria-label="Meet Our People"
>
  <!-- Sticky Section Title (initial position: top-8 md:top-12, sticks until half of Row 1's height) -->
  <div
    class="pointer-events-none z-30 w-full text-center relative pt-8 md:pt-12 h-[calc(22vh+4rem)] md:h-[calc(30dvh+6rem)] -mb-[calc(22vh+4rem)] md:-mb-[calc(30dvh+6rem)]"
  >
    <div
      class="sticky top-8 md:top-12 inline-block text-center whitespace-nowrap"
    >
      <h2 class="pixel-heading relative inline-block text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-wider text-white">
        <span class="pixel-heading-duplicate absolute top-[0.05em] -left-[0.05em] select-none pointer-events-none text-white" aria-hidden="true">
          Meet Our People!
        </span>
        <span class="pixel-heading-main relative text-white">
          Meet Our People!
        </span>
      </h2>
    </div>
  </div>

  <!-- Row 1: Scrolling Right (->) -->
  <div class="marquee-row relative w-full h-[42vh] min-h-[260px] sm:h-[52vh] sm:min-h-[320px] md:h-[60dvh] md:min-h-[380px] flex-shrink-0 overflow-hidden flex items-stretch p-0 m-0">
    <div class="marquee-track marquee-track-right flex h-full w-max p-0 m-0">
      {row1Track.map((member, i) => (
        <div
          class="member-card relative h-full aspect-[15/19] flex-shrink-0 cursor-pointer overflow-hidden p-0 m-0 group border-0 outline-none"
          data-member-id={member.id}
          data-division-id={member.divisionId}
          data-division={member.division}
          data-video={member.video}
          data-track-index={i}
          role="button"
          tabindex="0"
          aria-label={`Lihat divisi ${member.division}`}
        >
          <!-- Photo layer -->
          <img
            {...responsiveImage(member.image, "(max-width: 639px) max(205px, 33.2vh), (max-width: 767px) max(253px, 41.1vh), max(300px, 47.4dvh)", undefined, 100)}
            alt={`${member.division} photo`}
            width="594"
            height="781"
            loading="lazy"
            decoding="async"
            class="card-photo absolute inset-0 w-full h-full object-cover select-none pointer-events-none border-0 outline-none"
          />

          <!-- Video layer (hidden by default, shown on click, no borders) -->
          <video
            class="card-video absolute inset-0 w-full h-full object-cover select-none pointer-events-none opacity-0 border-0 outline-none"
            src={member.video}
            loop
            muted
            playsinline
            preload="none"
          ></video>

          <!-- Gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent pointer-events-none"></div>

          <!-- Bottom Division Label (disappears when video is playing) -->
          <div class="card-division-label absolute bottom-3 left-3 right-3 z-10 select-none pointer-events-none transition-all duration-300">
            <span class="text-white text-lg sm:text-xl md:text-2xl drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)] block">
              {member.division}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Division Detail Showcase Drawer (opens between Row 1 and Row 2) - Size: 1918x367.36px -->
  <div
    id="division-drawer"
    class="division-drawer w-full bg-white text-black relative z-30 shadow-[0_25px_60px_rgba(0,0,0,0.5)] border-neutral-200"
  >
    <div class="division-drawer-inner relative w-full overflow-hidden">


      {Object.values(resolvedDivisions).map((division) => (
        <div
          class="division-panel hidden w-full max-w-[1918px] mx-auto min-h-0 lg:h-[300px] flex items-center px-4 sm:px-10 md:px-12 lg:px-16 box-border"
          data-panel-id={division.id}
        >
          <div class="flex flex-col lg:flex-row items-start lg:items-center gap-2 w-full h-full py-4 box-border">
            
            <!-- Left Column: Division Title, Description & Badge -->
            <div class="w-full lg:w-[280px] xl:w-[320px] flex-shrink-0 flex flex-col justify-center lg:justify-start h-full py-1 px-4 sm:px-16 lg:px-0 lg:pt-[6px]">
              <div>
                <h3 class="text-[clamp(16px,5.5vw,24px)] md:text-4xl lg:text-5xl font-black text-black tracking-tight leading-[0.93] mb-2">
