</section>

<script>
  function initMarqueeInteraction() {
    const section = document.getElementById('members-section');
    if (!section) return;

    const drawer = document.getElementById('division-drawer');
    const closeBtn = document.getElementById('drawer-close-btn');
    const tracks = Array.from(section.querySelectorAll<HTMLElement>('.marquee-track'));
    const cards = Array.from(section.querySelectorAll<HTMLElement>('.member-card'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('.division-panel'));
    const rows = Array.from(section.querySelectorAll<HTMLElement>('.marquee-row'));

    // Track state
    let activeCard: HTMLElement | null = null;
    let activeVideo: HTMLVideoElement | null = null;
    let activeDivisionId: string | null = null;
    let closeScrollFrame = 0;

    function alignTopRow() {
      const row = rows[0] || section!;
      const top = Math.max(0, row.getBoundingClientRect().top + window.scrollY);
      if (window.lenis) window.lenis.scrollTo(top, { duration: 0.65 });
      else window.scrollTo({ top, behavior: 'smooth' });
    }


    function alignBottomRow() {
      cancelAnimationFrame(closeScrollFrame);
      section!.setAttribute('data-scroll-aligning', 'true');
      const initialGap = section!.getBoundingClientRect().bottom - window.innerHeight;
      const startTime = performance.now();
      function followBottom(now: number) {
        const progress = Math.min(1, (now - startTime) / 550);
        const remainingGap = initialGap * Math.pow(1 - progress, 3);
        const bottom = section!.getBoundingClientRect().bottom + window.scrollY;
        const top = Math.max(0, bottom - window.innerHeight - remainingGap);
        if (window.lenis) window.lenis.scrollTo(top, { immediate: true });
        else window.scrollTo({ top, behavior: 'instant' });
        if (progress < 1) closeScrollFrame = requestAnimationFrame(followBottom);
        else section!.removeAttribute('data-scroll-aligning');
      }
      closeScrollFrame = requestAnimationFrame(followBottom);
    }


    function deactivateCard() {
      const wasTopRow = activeCard
        ? (Boolean(activeCard.closest('.marquee-track-right')) || activeCard.dataset.memberId?.startsWith('r1'))
        : false;

      if (activeCard) {
        activeCard.classList.remove('is-active');
        // Stop & hide video, restore photo
        if (activeVideo) {
          activeVideo.pause();
          activeVideo.currentTime = 0;
          activeVideo.classList.add('opacity-0');
          activeVideo.classList.remove('opacity-100');
        }
        const photo = activeCard.querySelector<HTMLElement>('.card-photo');
        if (photo) {
          photo.classList.remove('opacity-0');
          photo.classList.add('opacity-100');
        }
        activeCard = null;
        activeVideo = null;
      }

      // Close drawer smoothly
      if (drawer) {
        drawer.classList.remove('is-open');
      }

      cancelAnimationFrame(closeScrollFrame);
      if (wasTopRow) {
        // Opening and closing a top-row card share the same scroll anchor.
        alignTopRow();
      } else {
        alignBottomRow();
      }

      // Hide all panels after animation completes (550ms, matching 500ms CSS transition)
      setTimeout(() => {
        if (!activeCard) {
          panels.forEach((p) => {
            p.classList.add('hidden');
            // Reset any blurred member cards when drawer closes
            p.querySelectorAll('.member-profile-card.is-blurred').forEach((c) => {
              c.classList.remove('is-blurred');
            });
          });
          activeDivisionId = null;
        }
      }, 550);

      // Resume marquee after close animation completes
      setTimeout(() => {
        if (!activeCard) {
          section!.removeAttribute('data-paused');
          tracks.forEach((t) => t.classList.remove('is-paused'));
        }
      }, 500);
    }

    function activateCard(card: HTMLElement) {
      cancelAnimationFrame(closeScrollFrame);
      section!.removeAttribute('data-scroll-aligning');
      const divisionId = card.getAttribute('data-division-id');
      if (!divisionId) return;

      // If clicking same card, toggle off
      if (activeCard === card) {
        deactivateCard();
        return;
      }

      // If another card was active, reset that card first
      if (activeCard && activeCard !== card) {
        activeCard.classList.remove('is-active');
        if (activeVideo) {
          activeVideo.pause();
          activeVideo.currentTime = 0;
          activeVideo.classList.add('opacity-0');
          activeVideo.classList.remove('opacity-100');
        }
        const photo = activeCard.querySelector<HTMLElement>('.card-photo');
        if (photo) {
          photo.classList.remove('opacity-0');
          photo.classList.add('opacity-100');
        }
      }

      // Pause marquee
      section!.setAttribute('data-paused', 'true');
      tracks.forEach((t) => t.classList.add('is-paused'));

      // Mark clicked card as active (division label disappears, no white borders)
      card.classList.add('is-active');
      activeCard = card;

      // Show video, hide photo
      const photo = card.querySelector<HTMLElement>('.card-photo');
      const video = card.querySelector<HTMLVideoElement>('.card-video');

      if (photo) {
        photo.classList.add('opacity-0');
        photo.classList.remove('opacity-100');
      }

      if (video) {
        activeVideo = video;
        video.classList.remove('opacity-0');
        video.classList.add('opacity-100');
        video.currentTime = 0;
        video.play().catch(() => {
          video.muted = true;
          video.play();
        });
      }

      // Switch division panel in drawer
      activeDivisionId = divisionId;
      panels.forEach((p) => {
        if (p.getAttribute('data-panel-id') === divisionId) {
          p.classList.remove('hidden');
          // Reset track scroll & blurred cards
          const track = p.querySelector<HTMLElement>('.members-draggable-track');
          if (track) track.scrollLeft = 0;
          p.querySelectorAll('.member-profile-card.is-blurred').forEach((c) => {
            c.classList.remove('is-blurred');
          });
        } else {
          p.classList.add('hidden');
        }
      });

      // Expand drawer & move display directly to video's position
      const isTopRow = Boolean(card.closest('.marquee-track-right')) || card.dataset.memberId?.startsWith('r1');

      if (drawer) {
        drawer.classList.add('is-open');
      }


      if (isTopRow) {
        alignTopRow();
      } else {
        alignBottomRow();
      }
    }

    // Card click events
    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        e.stopPropagation();
        activateCard(card);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.click();
        }
      });
    });

    // Close button event
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      deactivateCard();
    });

    // Escape key closes drawer
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeCard) {
        deactivateCard();
      }
    });

    // Setup drag-to-scroll & member card click for all member tracks
    initDraggableTracks();
    initMemberCardInteraction();
  }

  function initMemberCardInteraction() {
    initMemberNameFitting();
    const memberCards = Array.from(document.querySelectorAll<HTMLElement>('.member-profile-card'));
    const desktopHover = window.matchMedia('(min-width: 768px) and (hover: hover) and (pointer: fine)');

    memberCards.forEach((card) => {
      card.addEventListener('pointerenter', (event) => {
        if (desktopHover.matches && event.pointerType !== 'touch' && !event.buttons) {
          card.classList.add('is-blurred');
        }
      });
      card.addEventListener('pointerleave', () => {
        if (desktopHover.matches) card.classList.remove('is-blurred');
      });
      card.addEventListener('focusin', () => {
        if (desktopHover.matches) card.classList.add('is-blurred');
      });
      card.addEventListener('focusout', (event) => {
        if (desktopHover.matches && !card.contains(event.relatedTarget as Node | null)) {
          card.classList.remove('is-blurred');
        }
      });

      card.addEventListener('click', (e) => {
        const track = card.closest<HTMLElement>('.members-draggable-track');
        // If user was actively dragging, don't trigger click
        if (track && (track as any).__hasDragged) {
          e.preventDefault();
          return;
        }

        // If clicking on the LinkedIn link when already blurred, allow navigation
        const target = e.target as HTMLElement;
        if (target.closest('a.member-linkedin-link') && card.classList.contains('is-blurred')) {
          return;
        }

        e.preventDefault();
        e.stopPropagation();
        if (desktopHover.matches) return;
        // Toggle blur and LinkedIn reveal
        card.classList.toggle('is-blurred');
      });

      card.addEventListener('keydown', (e) => {
        if (e.target !== card) return;
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (desktopHover.matches) card.classList.add('is-blurred');
          else card.classList.toggle('is-blurred');
        }
      });
    });
  }

  function initMemberNameFitting() {
    const names = Array.from(document.querySelectorAll<HTMLElement>('.member-name'))
      .filter((name) => !name.dataset.fittingInitialized);
    if (!names.length) return;

    const fit = (name: HTMLElement) => {
      if (!name.isConnected || !name.clientWidth) return;
      const words = (name.dataset.fullName || '').split(/\s+/).filter(Boolean);
      const maxHeight = parseFloat(getComputedStyle(name).lineHeight) * 2;
      name.textContent = words.join(' ');
      while (words.length && (name.scrollHeight > maxHeight + 1 || name.scrollWidth > name.clientWidth)) {
        words.pop();
        name.textContent = words.join(' ');
      }
    };
    const observer = new ResizeObserver((entries) => {
      entries.forEach(({ target }) => fit(target as HTMLElement));
    });
    names.forEach((name) => {
      name.dataset.fittingInitialized = 'true';
      name.dataset.fullName = name.textContent?.trim() || '';
      observer.observe(name);
      fit(name);
    });
    document.fonts.ready.then(() => names.forEach(fit));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  function initDraggableTracks() {
    const tracks = document.querySelectorAll<HTMLElement>('.members-draggable-track');

    tracks.forEach((track) => {
      if (track.dataset.carouselInitialized) return;
      track.dataset.carouselInitialized = 'true';
      const mobileCarousel = window.matchMedia('(max-width: 767px)');
      let wheelTimer: ReturnType<typeof setTimeout> | undefined;
      let wheelActive = false;
      let pendingTarget: number | null = null;
      function scrollToMember(direction: number) {
        const inset = parseFloat(getComputedStyle(track).paddingLeft) || 0;
        const left = track.getBoundingClientRect().left + track.clientLeft;
        const limit = Math.max(0, track.scrollWidth - track.clientWidth);
        const targets = Array.from(track.children).map((card) =>
          Math.max(0, Math.min(limit, card.getBoundingClientRect().left - left + track.scrollLeft - inset))
        );
        const origin = pendingTarget ?? track.scrollLeft;
        const target = direction > 0
          ? targets.find((value) => value > origin + 2) ?? limit
          : targets.filter((value) => value < origin - 2).pop() ?? 0;
        pendingTarget = Math.abs(target - track.scrollLeft) > 1 ? target : null;
        track.scrollTo({ left: target, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      }
      track.addEventListener('scrollend', () => { pendingTarget = null; });

      const fade = track.closest('.carousel-container')?.querySelector<HTMLElement>('.carousel-fade-left');
      if (fade && !track.dataset.fadeInitialized) {
        track.dataset.fadeInitialized = 'true';
        const updateFade = () => {
          fade.style.opacity = String(Math.min(1, Math.max(0, track.scrollLeft) / 32));
        };
        track.addEventListener('scroll', updateFade, { passive: true });
        updateFade();
      }
      let isDown = false;
      let startX = 0;
      let dragStepped = false;
      let dragStartScroll = 0;

      track.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        isDown = true;
        dragStepped = false;
        (track as any).__hasDragged = false;
        startX = e.pageX;
        dragStartScroll = track.scrollLeft;
      });

      window.addEventListener('mouseup', () => {
        if (isDown) {
          isDown = false;
          track.classList.remove('is-dragging');
          setTimeout(() => {
            (track as any).__hasDragged = false;
          }, 80);
        }
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        const x = e.pageX;
        const diff = Math.abs(x - startX);
        if (diff > 5) {
          (track as any).__hasDragged = true;
          track.classList.add('is-dragging');
          e.preventDefault();
          if (mobileCarousel.matches) {
            track.scrollLeft = dragStartScroll - (x - startX) * 1.5;
          } else if (diff > 20 && !dragStepped) {
            dragStepped = true;
            scrollToMember(x < startX ? 1 : -1);
          }
        }
      });

      // Touch swipe support
      let touchStartX = 0;
      let touchStartY = 0;
      let touchStepped = false;
      track.addEventListener(
        'touchstart',
        (e) => {
          touchStartX = e.touches[0].pageX;
          touchStartY = e.touches[0].pageY;
          touchStepped = false;
          (track as any).__hasDragged = false;
        },
        { passive: true }
      );

      track.addEventListener(
        'touchmove',
        (e) => {
          if (e.touches.length !== 1) return;
          const dx = e.touches[0].pageX - touchStartX;
          const dy = e.touches[0].pageY - touchStartY;
          if (Math.abs(dx) <= Math.abs(dy) || Math.abs(dx) <= 8) return;
          (track as any).__hasDragged = true;
          if (mobileCarousel.matches) return;
          if (e.cancelable) e.preventDefault();
          if (Math.abs(dx) > 20 && !touchStepped) {
            touchStepped = true;
            scrollToMember(dx < 0 ? 1 : -1);
          }
        },
        { passive: false }
      );

      track.addEventListener(
        'touchend',
        () => {
          setTimeout(() => {
            (track as any).__hasDragged = false;
          }, 80);
        },
        { passive: true }
      );

      // Mouse wheel horizontal scroll
      track.addEventListener(
        'wheel',
        (e) => {
          const delta = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
          if (!delta || e.ctrlKey) return;
          if (mobileCarousel.matches) {
            if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
              e.preventDefault();
              track.scrollLeft += e.deltaY;
            }
            return;
          }
          e.preventDefault();
          if (!wheelActive && Math.abs(delta) > 2) {
            scrollToMember(delta > 0 ? 1 : -1);
            wheelActive = true;
          }
          clearTimeout(wheelTimer);
          wheelTimer = setTimeout(() => { wheelActive = false; }, 180);
        },
        { passive: false }
      );

      // Desktop navigation arrows
      const container = track.closest('.carousel-container');
      if (container) {
        const prevBtn = container.querySelector('.prev-btn');
        const nextBtn = container.querySelector('.next-btn');

        prevBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          scrollToMember(-1);
        });

        nextBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          scrollToMember(1);
        });
      }
    });
  }

  initMarqueeInteraction();
  document.addEventListener('astro:page-load', initMarqueeInteraction);
</script>

<style>
  .carousel-fade-left {
    --fade-width: 64px;
    width: var(--fade-width);
    left: calc(var(--fade-width) * -0.5);
    opacity: 0;
    background: linear-gradient(to right, white 0%, white 50%, rgba(255, 255, 255, 0.65) 72%, transparent 100%);
    transition: opacity 150ms ease-out;
  }
  @media (min-width: 640px) {
    .carousel-fade-left { --fade-width: 128px; }
  }
  @media (min-width: 768px) {
    .carousel-fade-left { --fade-width: 192px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel-fade-left { transition: none; }
  }

  .pixel-heading {
    font-family: 'Press Start 2P', 'Silkscreen', monospace;
    letter-spacing: 0.05em;
  }

  .pixel-heading-duplicate {
    font-family: inherit;
    letter-spacing: inherit;
    color: #ffffff;
    opacity: 1;
    z-index: 1;
    text-shadow: none;
  }

  .pixel-heading-main {
    font-family: inherit;
    letter-spacing: inherit;
    color: #ffffff;
    opacity: 1;
    z-index: 2;
    text-shadow: -1px 2px 6px rgba(0, 0, 0, 0.65);
  }

  .font-pixel {
    font-family: 'Press Start 2P', 'Silkscreen', monospace;
    text-shadow:
      -1px -1px 0 #000,
       1px -1px 0 #000,
      -1px  1px 0 #000,
       1px  1px 0 #000,
       0 2px 4px rgba(0, 0, 0, 0.9);
  }

  #members-section {
    overflow-anchor: none;
  }

  /* Photo & video fade transition */
  .card-photo,
  .card-video {
    transition: opacity 0.4s ease;
  }

  /* NO white border on active card */
  .member-card.is-active {
    box-shadow: none !important;
    outline: none !important;
    border: none !important;
    z-index: 25;
  }

  /* When card is active (video playing), hide the division text */
  .card-division-label {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .member-card.is-active .card-division-label {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(10px);
  }

  /* Division Drawer Smooth Grid Expansion */
  .division-drawer {
    border-block-width: 0;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .division-drawer.is-open {
    border-block-width: 1px;
    grid-template-rows: 1fr;
    opacity: 1;
    pointer-events: auto;
  }

  /* Overlap one pixel to prevent fractional viewport-height seams between rows. */
  .division-drawer:not(.is-open) + .marquee-row {
    margin-top: -1px;
  }

  .division-drawer-inner {
    min-height: 0;
    overflow: hidden;
  }

  /* Member Profile Card: Normal vs Blurred state */
  .member-name {
    max-height: 2.5em;
    overflow: hidden;
    overflow-wrap: normal;
    word-break: normal;
  }

  .member-profile-card {
    cursor: pointer;
  }

  .member-profile-card .member-photo {
    transition: filter 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    transform: scale(1);
    filter: blur(0px);
  }

  .member-profile-card .member-overlay {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.2) 50%, transparent 100%);
    transition: background 0.35s ease;
  }

  .member-profile-card .member-role {
    display: block;
    opacity: 1;
    transition: opacity 0.25s ease;
  }

  .member-profile-card .member-linkedin-link {
    display: none !important;
    opacity: 0;
  }

  /* BLURRED STATE (Identical to reference mockup Card 3) */
  .member-profile-card.is-blurred .member-photo {
    filter: blur(5px);
    transform: scale(1.06); /* prevents blur clipping / white edge bleed */
  }

  .member-profile-card.is-blurred .member-overlay {
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.65) 100%),
                linear-gradient(to top, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.1) 50%, rgba(0, 0, 0, 0.45) 100%);
  }

  .member-profile-card.is-blurred .member-role {
    display: none !important;
    opacity: 0;
  }

  .member-profile-card.is-blurred .member-linkedin-link {
    display: flex !important;
    opacity: 1;
  }

  /* Draggable track scrollbar hiding & smooth drag cursor */
  .members-draggable-track {
    touch-action: pan-x pan-y pinch-zoom;
    scrollbar-width: none;
    -ms-overflow-style: none;
    user-select: none;
    -webkit-user-select: none;
  }

  @media (min-width: 768px) {
    .members-draggable-track { touch-action: pan-y pinch-zoom; }
  }

  .members-draggable-track::-webkit-scrollbar {
    display: none;
  }

  .members-draggable-track.is-dragging {
    cursor: grabbing !important;
    scroll-behavior: auto !important;
  }

  /* Row 1: scrolls right (track moves from -50% → 0%) */
  @keyframes marquee-to-right {
    0%   { transform: translate3d(-50%, 0, 0); }
    100% { transform: translate3d(0%, 0, 0); }
  }

  /* Row 2: scrolls left (track moves from 0% → -50%) */
  @keyframes marquee-to-left {
    0%   { transform: translate3d(0%, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }

  .marquee-track-right {
    animation: marquee-to-right 55s linear infinite;
    will-change: transform;
  }

  .marquee-track-left {
    animation: marquee-to-left 55s linear infinite;
    will-change: transform;
  }

  /* Pause ONLY when card clicked */
  .marquee-track.is-paused,
  [data-paused="true"] .marquee-track {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track-right,
    .marquee-track-left {
      animation-play-state: paused !important;
    }
  }
</style>
