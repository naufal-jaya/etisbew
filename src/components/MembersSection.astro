<div class="carousel-fade-left pointer-events-none absolute left-0 top-0 bottom-0 w-8 sm:w-10 md:w-16 z-20 bg-[linear-gradient(to_right,#fff_0%,rgba(255,255,255,0.66)_45%,transparent_100%)]"></div>

