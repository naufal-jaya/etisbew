---
import { sanityClient, isSanityConfigured } from '../sanity/client';
import { urlForImage } from '../sanity/image';
import {
  fallbackPartners,
  fallbackMilestones,
  type PartnerItem,
  type MilestoneItem,
} from '../sanity/mockData';

// GROQ Queries
const PARTNERS_QUERY = `*[_type == "partner"] | order(order asc, _createdAt asc) { name, logo }`;
const MILESTONES_QUERY = `*[_type == "milestone"] | order(year asc) { 
  year, 
  description, 
  floatingImages[] {
    ...,
    "url": asset->url
  }
}`;

let partners: PartnerItem[] = [];
let milestones: MilestoneItem[] = [];

if (isSanityConfigured) {
  try {
    const [fetchedPartners, fetchedMilestones] = await Promise.all([
      sanityClient.fetch(PARTNERS_QUERY),
      sanityClient.fetch(MILESTONES_QUERY),
    ]);

    if (Array.isArray(fetchedPartners) && fetchedPartners.length > 0) {
      partners = fetchedPartners;
    } else {
      partners = fallbackPartners;
    }

    if (Array.isArray(fetchedMilestones) && fetchedMilestones.length > 0) {
      milestones = fetchedMilestones;
    } else {
      milestones = fallbackMilestones;
    }
  } catch (err) {
    console.warn('Could not fetch from Sanity CMS, falling back to local data:', err);
    partners = fallbackPartners;
    milestones = fallbackMilestones;
  }
} else {
  partners = fallbackPartners;
  milestones = fallbackMilestones;
}

// Grid layout parameters (10 columns to match reference design)
const totalCols = 10;
const totalRows = 2;
const minSlots = totalRows * totalCols; // 20 partner slots (2 full rows of 10)

const sourcePartners = partners.length > 0 ? partners : fallbackPartners;

// Extract unique partners list with resolved image URLs
const uniquePartnersMap = new Map<string, { name: string; logo: string }>();
sourcePartners.forEach((p) => {
  if (p && p.name && !uniquePartnersMap.has(p.name)) {
    const logoUrl = urlForImage(p.logo) || (typeof p.logo === 'string' ? p.logo : '');
    uniquePartnersMap.set(p.name, {
      name: p.name,
      logo: logoUrl,
    });
  }
});
const uniquePartnersList = Array.from(uniquePartnersMap.values());

// Generate the 20 display cells, grouped by diagonal sets (diagSet = row + col, 0..10)
const displayCells = Array.from({ length: minSlots }, (_, index) => {
  const row = Math.floor(index / totalCols);
  const col = index % totalCols;
  const diagSet = row + col;
  const initialPartner = uniquePartnersList[diagSet % uniquePartnersList.length] || { name: '', logo: '' };
  return {
    index,
    row,
    col,
    diagSet,
    initialPartner,
  };
});

// Static floating images for the background (fixed, not randomized)
const staticFloatingImgs = [
  { url: '/history-bg-1.png', alt: 'IEEE group photo 1' },
  { url: '/history-bg-2.png', alt: 'IEEE event photo 2' },
  { url: '/history-bg-3.png', alt: 'IEEE group photo 3' },
  { url: '/history-bg-4.png', alt: 'IEEE ceremony photo 4' },
  { url: '/history-bg-1.png', alt: 'IEEE campus photo 5' },
];

// Process milestones dynamically from Sanity CMS or fallback
const rawMilestones = milestones.length > 0 ? milestones : fallbackMilestones;
const sortedMilestones = [...rawMilestones].sort(
  (a, b) => parseInt(String(a.year), 10) - parseInt(String(b.year), 10)
);

const resolvedMilestones = sortedMilestones.map((m) => {
  return {
    year: String(m.year),
    description: m.description || '',
  };
});

// Set default active milestone (2026 if present, otherwise the last milestone)
const defaultYear = '2026';
const initialActiveIdx = resolvedMilestones.findIndex((m) => m.year === defaultYear);
const activeIndex = initialActiveIdx !== -1 ? initialActiveIdx : resolvedMilestones.length - 1;
const initialMilestone = resolvedMilestones[activeIndex] || resolvedMilestones[0];

---

<section id="section-history" data-lead-section="history" class="relative z-20 w-full bg-white text-gray-900 min-h-screen lg:h-screen lg:max-h-screen flex flex-col justify-between pt-2 sm:pt-3 md:pt-4 pb-0 overflow-hidden border-t-[2.5px] border-[#C8CAD4]">
  
  <!-- Left & Right blur/fade overlays (Spans full height of HistorySection to the very bottom) -->
  <div class="history-fade-left"></div>
  <div class="history-fade-right"></div>

  <!-- ========================================== -->
  <!-- SECTION A: Partners Throughout The Years  -->
  <!-- Full Width Edge-to-Edge (Mentok Kanan-Kiri)-->
  <!-- ========================================== -->
  <div class="w-full flex flex-col items-center">
    <!-- Section Title (centered) -->
    <div class="w-full text-center px-4 pt-2 sm:pt-4 mb-1.5 sm:mb-2 md:mb-3">
      <h2 class="text-center text-3xl md:text-4xl font-normal tracking-[0.015em] text-gray-900 font-sans leading-tight">
        Partners Throughout The Years
      </h2>
    </div>

    <!-- Connected Grid: Edge-to-edge square containers with 2.5px borders in #C8CAD4 -->
    <div class="relative w-full overflow-x-clip overflow-y-visible py-2">
      <!-- Grid Container: 10 columns spanning 100% width with 2.5px borders in #C8CAD4 -->
      <div
        id="partners-grid-root"
        class="relative w-full grid grid-cols-10 border-t-[2.5px] border-b-[2.5px] border-[#C8CAD4] select-none"
      >
        {displayCells.map((cell) => {
          const { index, row, col, diagSet, initialPartner } = cell;
          const isFirstCol = col === 0;
          const isLastCol = col === totalCols - 1;
          const isLastRow = row === totalRows - 1;

          return (
            <div
              class={`group relative flex items-center justify-center p-1 sm:p-1.5 md:p-2 aspect-square bg-white ${!isLastCol ? 'border-r-[2.5px] border-[#C8CAD4]' : ''} ${!isLastRow ? 'border-b-[2.5px] border-[#C8CAD4]' : ''}`}
              data-partner-cell
              data-cell-index={index}
              data-diag-set={diagSet}
            >
              <!-- Circular Node: Top-Left vertex (thicker 2.5px border in #C8CAD4) -->
              <span class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 w-3.5 h-3.5 md:w-4 md:h-4 rounded-full border-[2.5px] border-[#C8CAD4] bg-white z-20 pointer-events-none ring-2 ring-white"></span>

              <!-- Circular Node: Top-Right vertex (for rightmost column) -->
              {isLastCol && (
                <span class="absolute top-0 right-0 translate-x-1/2 -translate-y-1/2 w-3.5 h-3.5 md:w-4 md:h-4 rounded-full border-[2.5px] border-[#C8CAD4] bg-white z-20 pointer-events-none ring-2 ring-white"></span>
              )}

              <!-- Circular Node: Bottom-Left vertex (for bottom row) -->
              {isLastRow && (
                <span class="absolute bottom-0 left-0 -translate-x-1/2 translate-y-1/2 w-3.5 h-3.5 md:w-4 md:h-4 rounded-full border-[2.5px] border-[#C8CAD4] bg-white z-20 pointer-events-none ring-2 ring-white"></span>
              )}

              <!-- Circular Node: Bottom-Right vertex (for bottom-right corner) -->
              {isLastRow && isLastCol && (
                <span class="absolute bottom-0 right-0 translate-x-1/2 translate-y-1/2 w-3.5 h-3.5 md:w-4 md:h-4 rounded-full border-[2.5px] border-[#C8CAD4] bg-white z-20 pointer-events-none ring-2 ring-white"></span>
              )}

              <!-- Logo Content (Double-buffered layers for seamless shrink & fade-in) -->
              <div class="relative w-full h-full flex items-center justify-center overflow-hidden">
                <!-- Interactive Logo Target: sized precisely to logo, not the rectangle container -->
                <div
                  class="partner-logo-target relative flex items-center justify-center w-[70%] h-[70%] max-w-[78%] max-h-[65%] cursor-pointer group/logo"
                  data-partner-target
                >
                  <img
                    data-layer="a"
                    src={initialPartner.logo}
                    alt={initialPartner.name}
                    loading="eager"
                    class="partner-logo-layer absolute max-h-full max-w-full object-contain pointer-events-none transition-transform duration-200 group-hover/logo:scale-105"
                  />
                  <img
                    data-layer="b"
                    src=""
                    alt=""
                    loading="eager"
                    class="partner-logo-layer absolute max-h-full max-w-full object-contain opacity-0 pointer-events-none transition-transform duration-200 group-hover/logo:scale-105"
                    style="transform: scale(0.85);"
                  />
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Floating Tooltip for Partner Name (Appears when logo itself is hovered) -->
      <div
        id="partner-tooltip"
        role="tooltip"
        class="pointer-events-none fixed z-50 px-3.5 py-1.5 rounded-lg bg-[#1E2029] text-white text-xs sm:text-[13px] font-sans font-medium tracking-wide shadow-[0_8px_24px_rgba(0,0,0,0.35)] border border-[#383B47] transition-[opacity,transform] duration-200 ease-out opacity-0 scale-95 select-none"
        style="transform: translate(-50%, -100%); top: -9999px; left: -9999px;"
      >
        <span id="partner-tooltip-text"></span>
        <span
          id="partner-tooltip-arrow"
          class="absolute top-full left-1/2 -translate-x-1/2 -mt-[1px] border-4 border-transparent border-t-[#1E2029]"
        ></span>
      </div>
    </div>
  </div>
  <!-- ========================================== -->
  <!-- SECTION B: Our Persistent Growth           -->
  <!-- Full Width Edge-to-Edge (Mentok Kanan-Kiri)-->
  <!-- ========================================== -->
  <div id="history-growth-section" class="relative w-full flex-1 flex flex-col justify-end pt-6 sm:pt-8 pb-0 overflow-hidden select-none">
    
    <!-- Section Title (centered) -->
    <div class="w-full text-center px-4 mb-1 sm:mb-2">
      <h2 class="relative z-10 inline-block text-2xl sm:text-3xl md:text-4xl lg:text-[35px] xl:text-[40px] font-normal tracking-[0.015em] text-gray-900 font-sans leading-tight">
        Our Persistent Growth
      </h2>
    </div>
    
    <!-- Floating Scattered Images (Static scrapbook layout) -->
    <div class="pointer-events-none select-none absolute inset-0 z-0 overflow-hidden">
      <!-- Floating 1: Left above 2025 -->
      <div class="absolute left-[5%] md:left-[6%] top-[25%] md:top-[28%] w-28 h-18 sm:w-36 sm:h-22 md:w-44 md:h-28 bg-gray-200 border border-gray-300 shadow-[5px_5px_0px_rgba(203,213,225,0.9)] opacity-50 filter grayscale">
        <img src={staticFloatingImgs[0].url} alt={staticFloatingImgs[0].alt} class="w-full h-full object-cover" />
      </div>

      <!-- Floating 2: Top-left center (above title) -->
      <div class="absolute left-[24%] md:left-[26%] top-[2%] md:top-[4%] w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 bg-gray-200 border border-gray-300 shadow-[4px_4px_0px_rgba(203,213,225,0.9)] opacity-80 filter grayscale">
        <img src={staticFloatingImgs[1].url} alt={staticFloatingImgs[1].alt} class="w-full h-full object-cover" />
      </div>

      <!-- Floating 3: Right of Title (wide group photo) -->
      <div class="absolute left-[64%] md:left-[67%] top-[4%] md:top-[6%] w-32 h-20 sm:w-40 sm:h-24 md:w-48 md:h-30 bg-gray-200 border border-gray-300 shadow-[5px_5px_0px_rgba(203,213,225,0.9)] opacity-50 filter grayscale">
        <img src={staticFloatingImgs[2].url} alt={staticFloatingImgs[2].alt} class="w-full h-full object-cover" />
      </div>

      <!-- Floating 4: Far Right Top/Mid -->
      <div class="absolute right-[4%] md:right-[5%] top-[22%] md:top-[26%] w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 bg-gray-200 border border-gray-300 shadow-[4px_4px_0px_rgba(203,213,225,0.9)] opacity-100 filter grayscale">
        <img src={staticFloatingImgs[3].url} alt={staticFloatingImgs[3].alt} class="w-full h-full object-cover" />
      </div>

      <!-- Floating 5: Bottom Right under description text -->
      <div class="absolute left-[85%] md:left-[86%] bottom-[16px] md:bottom-[20px] w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 bg-gray-200 border border-gray-300 shadow-[4px_4px_0px_rgba(203,213,225,0.9)] opacity-80 filter grayscale">
        <img src={staticFloatingImgs[4].url} alt={staticFloatingImgs[4].alt} class="w-full h-full object-cover" />
      </div>
    </div>
    

    <!-- Timeline & Time Slider Container (Directly at the bottom edge, cut at bottom) -->
    <!-- Supports direct click, mouse drag & touch swipe to slide through years -->
    <div
      id="history-timeline-track"
      class="relative z-10 w-full h-[170px] sm:h-[185px] md:h-[200px] lg:h-[210px] cursor-grab select-none overflow-hidden touch-pan-y"
      title="Geser atau klik tahun untuk navigasi milestone"
    >
      <!-- Timeline Sliding Track Viewport with right fade-out mask -->
      <div
        id="timeline-viewport"
        class="absolute inset-0 pointer-events-auto"
      >
        <!-- The sliding ruler and milestones container -->
        <div
          id="timeline-slider"
          class="absolute top-0 bottom-0 left-0 flex items-end will-change-transform"
          style="transform: translate3d(0px, 0, 0);"
        >
          <!-- 1. Ruler Ticks Container (Intermediate ticks between milestones only) -->
          <div id="timeline-ticks" class="absolute inset-0 pointer-events-none">
            <!-- Intermediate ticks between consecutive milestones (Ends at 2022, no leading ticks) -->
            {resolvedMilestones.slice(0, -1).map((_, i) => (
              <>
                <span
                  data-milestone-step={i}
                  data-tick-sub="1"
                  class="timeline-tick absolute bottom-0 w-[2.5px] h-12 sm:h-14 md:h-16 lg:h-18 bg-[#C8CAD4]"
                ></span>
                <span
                  data-milestone-step={i}
                  data-tick-sub="2"
                  class="timeline-tick absolute bottom-0 w-[2.5px] h-12 sm:h-14 md:h-16 lg:h-18 bg-[#C8CAD4]"
                ></span>
                <span
                  data-milestone-step={i}
                  data-tick-sub="3"
                  class="timeline-tick absolute bottom-0 w-[2.5px] h-12 sm:h-14 md:h-16 lg:h-18 bg-[#C8CAD4]"
                ></span>
              </>
            ))}
          </div>

          <!-- 2. Dynamic Milestones: Render each year with stem, circular node, and year number -->
          {resolvedMilestones.map((milestone, idx) => {
            const isActive = idx === activeIndex;

            return (
              <button
                type="button"
                class="milestone-btn absolute bottom-0 flex flex-col items-center cursor-pointer group focus:outline-none select-none z-20 px-2"
                data-index={idx}
                data-year={milestone.year}
                aria-label={`Pilih tahun ${milestone.year}`}
              >
                <!-- Year Number -->
                <span
                  class={`milestone-year-text font-tech text-5xl sm:text-6xl md:text-7xl lg:text-[76px] tracking-wider leading-none mb-1.5 sm:mb-2 select-none uppercase transition-all duration-200 cursor-pointer group-hover:text-gray-900 group-hover:!opacity-100 ${
                    isActive ? 'text-[#1E2029]' : 'text-[#8F94A6]'
                  }`}
                >
                  {milestone.year}
                </span>

                <!-- Circular Node -->
                <div
                  class={`milestone-node w-4 h-4 sm:w-5 sm:h-5 rounded-full border-[2.5px] bg-white z-10 flex items-center justify-center transition-all duration-200 ${
                    isActive ? 'border-[#1E2029] ring-2 ring-gray-300' : 'border-[#C8CAD4] group-hover:border-gray-500'
                  }`}
                >
                  <div
                    class={`milestone-inner-dot w-2 h-2 rounded-full transition-all duration-200 ${
                      isActive ? 'bg-[#1E2029]' : 'bg-transparent'
                    }`}
                  ></div>
                </div>

                <!-- Vertical Stem touching bottom-0 -->
                <div
                  class={`milestone-stem w-[2.5px] h-12 sm:h-14 md:h-16 lg:h-18 -mt-[2px] transition-colors duration-200 ${
                    isActive ? 'bg-[#1E2029]' : 'bg-[#C8CAD4]'
                  }`}
                ></div>
              </button>
            );
          })}
        </div>
      </div>

      <!-- 3. Description Text (Always sticks at the end of the timeline white fade) -->
      <div
        id="milestone-desc-container"
        class="absolute bottom-[32px] sm:bottom-[40px] md:bottom-[48px] lg:bottom-[54px] max-w-[280px] sm:max-w-sm md:max-w-md lg:max-w-sm select-none z-30 pointer-events-auto pr-3 sm:pr-4"
        style="left: calc(var(--timeline-fade-end, 66%) + 8px);"
      >
        <p
          id="milestone-desc-text"
          class="text-xs sm:text-sm md:text-[14px] text-gray-900 leading-[1.6] font-sans font-normal tracking-[0.015em] transition-opacity duration-200"
        >
          {initialMilestone.description}
        </p>
      </div>

    </div>

  </div>
</section>

<!-- Client Script: Interactive Milestone Scroll Wheel / Click / Drag Centering Handler -->
<script is:inline define:vars={{ milestonesData: resolvedMilestones, initialIdx: activeIndex }}>
  (function () {
    const milestones = milestonesData || [];
    let currentIndex = typeof initialIdx === 'number' ? initialIdx : milestones.length - 1;

    const growthSection = document.getElementById('history-growth-section');
    const track = document.getElementById('history-timeline-track');
    const slider = document.getElementById('timeline-slider');
    const descText = document.getElementById('milestone-desc-text');
    const buttons = Array.from(document.querySelectorAll('.milestone-btn'));

    if (!track || !slider || milestones.length === 0) return;

    let focalX = 0;
    let stepX = 240;
    let currentSliderX = 0;
    let isDragging = false;
    let hasDragged = false;
    let startPointerX = 0;
    let startSliderX = 0;
    let lastPointerX = 0;

    function calculateDimensions() {
      const trackWidth = track.clientWidth || window.innerWidth;
      if (trackWidth >= 1024) {
        focalX = Math.round(trackWidth * 0.50);
        stepX = Math.round(Math.min(270, Math.max(220, trackWidth * 0.18)));
      } else if (trackWidth >= 640) {
        focalX = Math.round(trackWidth * 0.48);
        stepX = Math.round(Math.min(230, Math.max(180, trackWidth * 0.22)));
      } else {
        focalX = Math.round(trackWidth * 0.40);
        stepX = Math.round(Math.min(190, Math.max(140, trackWidth * 0.30)));
      }

      // Position milestone buttons on slider
      buttons.forEach((btn, idx) => {
        const x = idx * stepX;
        btn.style.left = `${x}px`;
      });

      // Position intermediate ticks between milestones (Ends at 2022, no leading ticks)
      const intermediateTicks = slider.querySelectorAll('[data-milestone-step]');
      intermediateTicks.forEach((tick) => {
        const stepIdx = parseInt(tick.getAttribute('data-milestone-step') || '0', 10);
        const subIdx = parseInt(tick.getAttribute('data-tick-sub') || '1', 10);
        const tickX = stepIdx * stepX + subIdx * 0.25 * stepX;
        tick.style.left = `${tickX}px`;
      });
    }

    function setSliderPosition(x, animate = true) {
      currentSliderX = x;
      if (animate) {
        slider.style.transition = 'transform 450ms cubic-bezier(0.16, 1, 0.3, 1)';
      } else {
        slider.style.transition = 'none';
      }
      slider.style.transform = `translate3d(${x}px, 0, 0)`;
    }

    function updateVisuals(index) {
      buttons.forEach((btn, idx) => {
        const yearText = btn.querySelector('.milestone-year-text');
        const node = btn.querySelector('.milestone-node');
        const innerDot = btn.querySelector('.milestone-inner-dot');
        const stem = btn.querySelector('.milestone-stem');

        const diff = idx - index;

        // The line (stem and node) under unselected years NEVER fades out!
        // Button container is ALWAYS full opacity 1 at baseline
        btn.style.opacity = '1';
        btn.style.transform = 'translateX(-50%)';

        if (diff === 0) {
          // Selected Active Year
          btn.setAttribute('aria-current', 'true');
          btn.style.pointerEvents = 'auto';
          if (yearText) {
            yearText.classList.remove('text-[#8F94A6]');
            yearText.classList.add('text-[#1E2029]');
            yearText.style.opacity = '1';
          }
          if (node) {
            node.classList.remove('border-[#C8CAD4]');
            node.classList.add('border-[#1E2029]', 'ring-2', 'ring-gray-300');
          }
          if (innerDot) {
            innerDot.classList.remove('bg-transparent');
            innerDot.classList.add('bg-[#1E2029]');
          }
          if (stem) {
            stem.classList.remove('bg-[#C8CAD4]');
            stem.classList.add('bg-[#1E2029]');
          }
        } else {
          // Unselected Years: keep stem and node solid #C8CAD4 with full opacity 1
          btn.removeAttribute('aria-current');
          if (node) {
            node.classList.remove('border-[#1E2029]', 'ring-2', 'ring-gray-300');
            node.classList.add('border-[#C8CAD4]');
          }
          if (innerDot) {
            innerDot.classList.remove('bg-[#1E2029]');
            innerDot.classList.add('bg-transparent');
          }
          if (stem) {
            stem.classList.remove('bg-[#1E2029]');
            stem.classList.add('bg-[#C8CAD4]');
          }

          if (diff < 0) {
            // Older years (to the left): visible and clickable
            btn.style.pointerEvents = 'auto';
            if (yearText) {
              yearText.classList.remove('text-[#1E2029]');
              yearText.classList.add('text-[#8F94A6]');
              if (diff === -1) {
                yearText.style.opacity = '0.70';
              } else if (diff === -2) {
                yearText.style.opacity = '0.50';
              } else if (diff === -3) {
                yearText.style.opacity = '0.35';
              } else {
                yearText.style.opacity = '0.22';
              }
            }
          } else {
            // More recent years (to the right of selected):
            // Year text is hidden so it appears as empty gradient space
            if (yearText) {
              yearText.style.opacity = '0';
            }
            btn.style.pointerEvents = 'auto';
          }
        }
      });
    }

    function goToMilestone(index, animate = true) {
      if (index < 0 || index >= milestones.length) return;
      currentIndex = index;
      const target = milestones[index];

      // 1. Center the selected year directly at the center of the screen
      const targetX = focalX - currentIndex * stepX;
      setSliderPosition(targetX, animate);

      // 2. Update button styles, opacities, and states
      updateVisuals(index);

      // 3. Update description with fade
      if (descText) {
        descText.style.opacity = '0';
        setTimeout(() => {
          descText.textContent = target.description || '';
          descText.style.opacity = '1';
        }, 140);
      }

      // Background images are completely static (no randomization / swapping)
    }

    // Initialize layout and state
    calculateDimensions();
    goToMilestone(currentIndex, false);

    // Window resize handler
    window.addEventListener('resize', () => {
      calculateDimensions();
      setSliderPosition(focalX - currentIndex * stepX, false);
      updateVisuals(currentIndex);
    });

    // ==========================================
    // 1. Unified Click Handler on Track
    // ==========================================
    track.addEventListener('click', (e) => {
      // Ignore click if a drag just occurred
      if (hasDragged) return;

      // Don't navigate if clicking description box
      if (e.target && e.target.closest('#milestone-desc-text')) return;

      const trackRect = track.getBoundingClientRect();
      const clickX = e.clientX - trackRect.left;
      const activeScreenX = currentSliderX + currentIndex * stepX;

      // 1. Check if user clicked directly on or inside a milestone button
      const clickedBtn = e.target.closest('.milestone-btn');
      if (clickedBtn) {
        const idx = parseInt(clickedBtn.getAttribute('data-index') || '0', 10);
        if (idx > currentIndex) {
          // If clicked on a year to the right, advance to next year
          if (currentIndex < milestones.length - 1) {
            goToMilestone(currentIndex + 1, true);
          }
          return;
        } else if (idx < currentIndex) {
          goToMilestone(idx, true);
          return;
        }
        return;
      }

      // 2. Click on the right side of the selected year (empty gradient space)
      // "clicking on the rightside of selected year (which is empty gradient space) will select the next year. unless its the latest year"
      if (clickX > activeScreenX + 35) {
        if (currentIndex < milestones.length - 1) {
          goToMilestone(currentIndex + 1, true);
        }
        return;
      }

      // 3. Click on the timeline ticks / space to the left of the selected year
      if (clickX < activeScreenX - 35) {
        const sliderClickX = clickX - currentSliderX;
        const targetIdx = Math.round(sliderClickX / stepX);
        if (targetIdx >= 0 && targetIdx < currentIndex) {
          goToMilestone(targetIdx, true);
        }
        return;
      }
    });

    // Also attach direct click listeners to buttons to guarantee instantaneous response
    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (hasDragged) return;
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        if (idx > currentIndex) {
          if (currentIndex < milestones.length - 1) {
            goToMilestone(currentIndex + 1, true);
          }
        } else if (idx < currentIndex) {
          goToMilestone(idx, true);
        }
      });
    });

    // ==========================================
    // 2. Draggable Navigation (Mouse & Touch)
    // ==========================================
    track.addEventListener('pointerdown', (e) => {
      // Don't drag if clicking description
      if (e.target && e.target.closest('#milestone-desc-text')) return;

      isDragging = true;
      hasDragged = false;
      startPointerX = e.clientX;
      lastPointerX = e.clientX;
      startSliderX = currentSliderX;
      slider.style.transition = 'none';
      // Notice: Do NOT call setPointerCapture here!
      // Calling setPointerCapture on pointerdown suppresses click events on child buttons.
    });

    window.addEventListener('pointermove', (e) => {
      if (!isDragging) return;

      lastPointerX = e.clientX;
      const deltaX = e.clientX - startPointerX;

      // Only engage drag mode and pointer capture after moving past threshold (6px)
      if (!hasDragged && Math.abs(deltaX) > 6) {
        hasDragged = true;
        track.classList.add('cursor-grabbing');
        try {
          if (e.pointerId) track.setPointerCapture(e.pointerId);
        } catch (_) {}
      }

      if (hasDragged) {
        const minX = focalX - (milestones.length - 1) * stepX;
        const maxX = focalX;
        let newX = startSliderX + deltaX;

        // Apply rubber banding at edges
        if (newX > maxX) {
          newX = maxX + (newX - maxX) * 0.25;
        } else if (newX < minX) {
          newX = minX + (newX - minX) * 0.25;
        }

        setSliderPosition(newX, false);
      }
    });

    function finishDrag(e) {
      if (!isDragging) return;
      isDragging = false;
      track.classList.remove('cursor-grabbing');
      try {
        if (e && e.pointerId && track.hasPointerCapture && track.hasPointerCapture(e.pointerId)) {
          track.releasePointerCapture(e.pointerId);
        }
      } catch (_) {}

      if (hasDragged) {
        const currentX = (e && typeof e.clientX === 'number') ? e.clientX : lastPointerX;
        const deltaX = currentX - startPointerX;
        let snappedIdx = Math.round((focalX - currentSliderX) / stepX);

        if (deltaX < -25 && snappedIdx <= currentIndex) {
          snappedIdx = Math.min(milestones.length - 1, currentIndex + 1);
        } else if (deltaX > 25 && snappedIdx >= currentIndex) {
          snappedIdx = Math.max(0, currentIndex - 1);
        }

        snappedIdx = Math.max(0, Math.min(milestones.length - 1, snappedIdx));
        goToMilestone(snappedIdx, true);

        // Keep hasDragged true briefly to suppress immediate click trigger
        setTimeout(() => {
          hasDragged = false;
        }, 80);
      }
    }

    window.addEventListener('pointerup', finishDrag);
    window.addEventListener('pointercancel', finishDrag);

    // ==========================================
    // 3. Keyboard Navigation
    // ==========================================
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        if (currentIndex < milestones.length - 1) {
          goToMilestone(currentIndex + 1, true);
        }
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        if (currentIndex > 0) {
          goToMilestone(currentIndex - 1, true);
        }
      }
    });
  })();
</script>

<!-- Client Script: Diagonal Wave Looping Animation & Partner Logo Tooltip -->
<script is:inline define:vars={{ partnersPool: uniquePartnersList }}>
  (function () {
    const gridRoot = document.getElementById('partners-grid-root');
    const tooltip = document.getElementById('partner-tooltip');
    const tooltipText = document.getElementById('partner-tooltip-text');
    const tooltipArrow = document.getElementById('partner-tooltip-arrow');

    if (!gridRoot || !Array.isArray(partnersPool) || partnersPool.length < 2) return;

    // Check user preference for reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Preload all partner logo images to guarantee 0% flicker
    partnersPool.forEach((p) => {
      if (p && p.logo) {
        const img = new Image();
        img.src = p.logo;
      }
    });

    const cells = Array.from(gridRoot.querySelectorAll('[data-partner-cell]'));
    const targets = Array.from(gridRoot.querySelectorAll('[data-partner-target]'));

    // Group cells by diagonal set (diagSet = 0 to 10)
    // d = 0 is leftmost corner (1 cell)
    // d = 1..9 are diagonal pairs (2 cells each)
    // d = 10 is rightmost corner (1 cell)
    const setsMap = new Map();
    cells.forEach((cell) => {
      const diagSet = parseInt(cell.getAttribute('data-diag-set') || '0', 10);
      if (!setsMap.has(diagSet)) {
        setsMap.set(diagSet, []);
      }
      setsMap.get(diagSet).push(cell);
    });

    // Track which layer is currently active ('a' or 'b') for each cell
    const cellActiveLayer = new Map();
    cells.forEach((cell) => {
      cellActiveLayer.set(cell, 'a');
    });

    const totalSets = setsMap.size; // 11 sets: 0 through 10
    const staggerDelay = 140; // ms delay between consecutive diagonal sets (wave ripple speed)
    const shrinkDuration = 320; // ms for shrink animation
    const fadeInDuration = 400; // ms for fade-in animation
    const waveRestInterval = 2800; // ms pause between complete wave loops

    let currentWave = 0;
    let isWaveActive = false;
    let isVisible = true;
    let isHovered = false;
    let nextWaveTimeout = null;
    let stepTimer = null;
    let currentSetIndex = 0;

    // ========================================================
    // Tooltip Engine (Targeted strictly to the logo element)
    // ========================================================
    function showTooltip(target) {
      if (!tooltip || !tooltipText) return;

      const cell = target.closest('[data-partner-cell]');
      if (!cell) return;

      const activeLayerKey = cellActiveLayer.get(cell) || 'a';
      const activeImg = cell.querySelector(`[data-layer="${activeLayerKey}"]`);
      const name = activeImg ? activeImg.getAttribute('alt') || '' : '';
      if (!name) return;

      tooltipText.textContent = name;

      const rect = target.getBoundingClientRect();
      const tooltipWidth = tooltip.offsetWidth || 140;
      const tooltipHeight = tooltip.offsetHeight || 32;

      // Center horizontally over the logo
      let left = rect.left + rect.width / 2;
      // Position above the logo by default
      let top = rect.top - 8;
      let isAbove = true;

      // If too close to viewport top, show below the logo instead
      if (rect.top < tooltipHeight + 16) {
        top = rect.bottom + 8;
        isAbove = false;
      }

      // Prevent horizontal overflow past viewport edges
      const minLeft = tooltipWidth / 2 + 12;
      const maxLeft = window.innerWidth - tooltipWidth / 2 - 12;
      left = Math.max(minLeft, Math.min(left, maxLeft));

      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${top}px`;

      if (tooltipArrow) {
        if (isAbove) {
          tooltip.style.transform = 'translate(-50%, -100%)';
          tooltipArrow.className = 'absolute top-full left-1/2 -translate-x-1/2 -mt-[1px] border-4 border-transparent border-t-[#1E2029]';
        } else {
          tooltip.style.transform = 'translate(-50%, 0)';
          tooltipArrow.className = 'absolute bottom-full left-1/2 -translate-x-1/2 -mb-[1px] border-4 border-transparent border-b-[#1E2029]';
        }
      }

      tooltip.classList.remove('opacity-0', 'scale-95');
      tooltip.classList.add('opacity-100', 'scale-100');
    }

    function hideTooltip() {
      if (!tooltip) return;
      tooltip.classList.remove('opacity-100', 'scale-100');
      tooltip.classList.add('opacity-0', 'scale-95');
    }

    // Attach hover listeners ONLY to the logo interactive targets
    targets.forEach((target) => {
      target.addEventListener('mouseenter', () => {
        isHovered = true;
        showTooltip(target);
      });

      target.addEventListener('mouseleave', () => {
        isHovered = false;
        hideTooltip();
        if (!isWaveActive) {
          scheduleNextWave(1200);
        }
      });
    });

    window.addEventListener('scroll', hideTooltip, { passive: true });
    window.addEventListener('resize', hideTooltip, { passive: true });

    // ========================================================
    // Looping Diagonal Wave Animation Engine with Pause Support
    // ========================================================
    function runWave() {
      if (!isVisible || isHovered) {
        scheduleNextWave(600);
        return;
      }

      isWaveActive = true;
      currentWave++;
      currentSetIndex = 0;

      stepNextSet();
    }

    function stepNextSet() {
      if (stepTimer) clearTimeout(stepTimer);

      // If user is hovering on a logo, pause the wave and check periodically
      if (isHovered) {
        stepTimer = setTimeout(stepNextSet, 120);
        return;
      }

      if (currentSetIndex < totalSets) {
        const d = currentSetIndex;
        animateDiagonalSet(d);
        currentSetIndex++;
        stepTimer = setTimeout(stepNextSet, staggerDelay);
      } else {
        // All diagonal sets in this wave have been triggered; wait for transition to finish
        setTimeout(() => {
          isWaveActive = false;
          scheduleNextWave(waveRestInterval);
        }, shrinkDuration + fadeInDuration);
      }
    }

    function animateDiagonalSet(d) {
      const setCells = setsMap.get(d) || [];
      const nextPartnerIndex = (d + currentWave) % partnersPool.length;
      const nextPartner = partnersPool[nextPartnerIndex];

      setCells.forEach((cell) => {
        const activeLayerKey = cellActiveLayer.get(cell) || 'a';
        const nextLayerKey = activeLayerKey === 'a' ? 'b' : 'a';

        const activeImg = cell.querySelector(`[data-layer="${activeLayerKey}"]`);
        const nextImg = cell.querySelector(`[data-layer="${nextLayerKey}"]`);

        if (!activeImg || !nextImg) return;

        // 1. Prepare nextImg with the new partner details while still hidden
        nextImg.src = nextPartner.logo;
        nextImg.alt = nextPartner.name;
        nextImg.style.transition = 'none';
        nextImg.style.transform = prefersReducedMotion ? 'scale(1)' : 'scale(0.85)';
        nextImg.style.opacity = '0';

        // 2. Shrink currently active image
        if (prefersReducedMotion) {
          activeImg.style.transition = `opacity ${shrinkDuration}ms ease-in`;
          activeImg.style.opacity = '0';
        } else {
          activeImg.style.transition = `transform ${shrinkDuration}ms cubic-bezier(0.4, 0, 0.2, 1), opacity ${Math.round(shrinkDuration * 0.85)}ms ease-in`;
          activeImg.style.transform = 'scale(0)';
          activeImg.style.opacity = '0';
        }

        // 3. Fade in replacing image as the previous image shrinks out
        const fadeInDelay = Math.round(shrinkDuration * 0.8);
        setTimeout(() => {
          if (!isVisible) return;
          void nextImg.offsetWidth; // Force reflow to commit prep styles

          if (prefersReducedMotion) {
            nextImg.style.transition = `opacity ${fadeInDuration}ms ease-out`;
            nextImg.style.opacity = '1';
          } else {
            nextImg.style.transition = `transform ${fadeInDuration}ms cubic-bezier(0.16, 1, 0.3, 1), opacity ${fadeInDuration}ms ease-out`;
            nextImg.style.transform = 'scale(1)';
            nextImg.style.opacity = '1';
          }

          // 4. Update the active layer reference for this cell
          cellActiveLayer.set(cell, nextLayerKey);

          // 5. Clean up old active image once fade-in finishes
          setTimeout(() => {
            activeImg.style.transition = 'none';
            activeImg.style.transform = 'scale(0.85)';
            activeImg.style.opacity = '0';
          }, fadeInDuration);
        }, fadeInDelay);
      });
    }

    function scheduleNextWave(delayMs) {
      if (nextWaveTimeout) clearTimeout(nextWaveTimeout);
      nextWaveTimeout = setTimeout(() => {
        runWave();
      }, delayMs);
    }

    // Initial start after 2.2 seconds
    scheduleNextWave(2200);

    // Viewport intersection observer to save CPU/battery when not visible
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting && document.visibilityState === 'visible';
          if (isVisible && !isWaveActive && !nextWaveTimeout) {
            scheduleNextWave(1000);
          }
        });
      },
      { threshold: 0.05 }
    );
    observer.observe(gridRoot);

    document.addEventListener('visibilitychange', () => {
      isVisible = document.visibilityState === 'visible';
      if (isVisible && !isWaveActive && !nextWaveTimeout) {
        scheduleNextWave(1000);
      }
    });
  })();
</script>

