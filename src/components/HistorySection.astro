---
import MobilePartnerGrid from './MobilePartnerGrid.astro';
import { sanityClient, isSanityConfigured } from '../sanity/client';
import { urlForImage, optimizeImageUrl } from '../sanity/image';
import {
  fallbackPartners,
  fallbackMilestones,
  type PartnerItem,
  type MilestoneItem,
} from '../sanity/mockData';

// GROQ Queries
const PARTNERS_QUERY = `*[_type == "partner"] | order(order asc, _createdAt asc) { name, logo }`;
const MILESTONES_QUERY = `*[_type == "milestone"] | order(year asc) { 
  year, 
  description, 
  floatingImages[] {
    ...,
    "url": asset->url
  }
}`;

let partners: PartnerItem[] = [];
let milestones: MilestoneItem[] = [];

if (isSanityConfigured) {
  try {
    const [fetchedPartners, fetchedMilestones] = await Promise.all([
      sanityClient.fetch(PARTNERS_QUERY),
      sanityClient.fetch(MILESTONES_QUERY),
    ]);

    if (Array.isArray(fetchedPartners) && fetchedPartners.length > 0) {
      partners = fetchedPartners;
    } else {
      partners = fallbackPartners;
    }

    if (Array.isArray(fetchedMilestones) && fetchedMilestones.length > 0) {
      milestones = fetchedMilestones;
    } else {
      milestones = fallbackMilestones;
    }
  } catch (err) {
    console.warn('Could not fetch from Sanity CMS, falling back to local data:', err);
    partners = fallbackPartners;
    milestones = fallbackMilestones;
  }
} else {
  partners = fallbackPartners;
  milestones = fallbackMilestones;
}

// Desktop Grid layout parameters (10 columns x 2 rows = 20 slots)
const desktopCols = 10;
const desktopRows = 2;
const desktopSlots = desktopRows * desktopCols;

const sourcePartners = partners.length > 0 ? partners : fallbackPartners;

// Extract unique partners list with resolved image URLs
const uniquePartnersMap = new Map<string, { name: string; logo: string }>();
sourcePartners.forEach((p) => {
  if (p && p.name && !uniquePartnersMap.has(p.name)) {
    const logoUrl = urlForImage(p.logo) || (typeof p.logo === 'string' ? p.logo : '');
    uniquePartnersMap.set(p.name, {
      name: p.name,
      logo: optimizeImageUrl(logoUrl, 480, 90),
    });
  }
});
const uniquePartnersList = Array.from(uniquePartnersMap.values());

// Generate Desktop 20 display cells (10x2)
const desktopDisplayCells = Array.from({ length: desktopSlots }, (_, index) => {
  const row = Math.floor(index / desktopCols);
  const col = index % desktopCols;
  const diagSet = row + col;
  const initialPartner = uniquePartnersList[diagSet % uniquePartnersList.length] || { name: '', logo: '' };
  return {
    index,
    row,
    col,
    diagSet,
    initialPartner,
  };
});

// Static floating images for the background (fixed, not randomized)
const staticFloatingImgs = [
  { url: '/history-bg-1.png', alt: 'IEEE group photo 1' },
  { url: '/history-bg-2.png', alt: 'IEEE event photo 2' },
  { url: '/history-bg-3.png', alt: 'IEEE group photo 3' },
  { url: '/history-bg-4.png', alt: 'IEEE ceremony photo 4' },
  { url: '/history-bg-1.png', alt: 'IEEE campus photo 5' },
];

// Process milestones dynamically from Sanity CMS or fallback
const rawMilestones = milestones.length > 0 ? milestones : fallbackMilestones;
const sortedMilestones = [...rawMilestones].sort(
  (a, b) => parseInt(String(a.year), 10) - parseInt(String(b.year), 10)
);

const resolvedMilestones = sortedMilestones.map((m) => {
  return {
    year: String(m.year),
    description: m.description || '',
  };
});

// Set default active milestone (2026 if present, otherwise the last milestone)
const defaultYear = '2026';
const initialActiveIdx = resolvedMilestones.findIndex((m) => m.year === defaultYear);
const activeIndex = initialActiveIdx !== -1 ? initialActiveIdx : resolvedMilestones.length - 1;
const initialMilestone = resolvedMilestones[activeIndex] || resolvedMilestones[0];

---

<section id="section-history" data-lead-section="history" class="relative z-20 w-full bg-white text-gray-900 h-screen min-h-[640px] md:h-screen md:min-h-screen md:max-h-screen flex flex-col justify-between pt-0 pb-0 overflow-hidden">
  
  <!-- Left & Right blur/fade overlays (Spans full height of HistorySection to the very bottom) -->
  <div class="history-fade-left"></div>
  <div class="history-fade-right"></div>

  <!-- ========================================== -->
  <!-- TOP HALF (Mobile) / SECTION A (Desktop)    -->
  <!-- ========================================== -->
  <div id="history-partners-section" class="relative w-full h-1/2 md:h-auto flex flex-col justify-between md:justify-start items-center overflow-hidden select-none">
    <!-- Section Title (centered with matched top/bottom margins) -->
    <div class="w-full text-center px-4 my-3 sm:my-4 md:my-5 flex-shrink-0">
      <h2 class="text-center text-xl sm:text-2xl md:text-3xl lg:text-4xl font-normal tracking-[0.015em] text-gray-900 font-sans leading-tight">
        Partners Throughout The Years
      </h2>
    </div>

    <!-- Three independent grids retain the existing diagonal logo-wave behavior. -->
    <div class="mobile-partners-stage md:hidden">
      <MobilePartnerGrid partners={uniquePartnersList} small offset={1} />
      <MobilePartnerGrid partners={uniquePartnersList} />
      <MobilePartnerGrid partners={uniquePartnersList} small offset={2} />
    </div>

    <!-- DESKTOP GRID: 10 columns x 2 rows (10x2, visible on screens >= md) -->
    <div class="relative w-full overflow-x-clip overflow-y-visible py-2 hidden md:block">
      <div
        class="partners-grid-root relative w-full grid grid-cols-10 border-t-[2px] border-b-[2px] border-[#C8CAD4] select-none"
      >
        {desktopDisplayCells.map((cell) => {
          const { index, row, col, diagSet, initialPartner } = cell;
          const isFirstCol = col === 0;
          const isLastCol = col === desktopCols - 1;
          const isLastRow = row === desktopRows - 1;

          return (
            <div
              class={`group relative flex items-center justify-center p-1.5 md:p-2 aspect-square bg-white ${!isLastCol ? 'border-r-[2px] border-[#C8CAD4]' : ''} ${!isLastRow ? 'border-b-[2px] border-[#C8CAD4]' : ''}`}
              data-partner-cell
              data-cell-index={index}
              data-diag-set={diagSet}
            >
              <!-- Circular Node: Top-Left vertex -->
              <span class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 w-[12px] h-[12px] rounded-full border-[2px] border-[#C8CAD4] bg-white z-20 pointer-events-none"></span>

              <!-- Circular Node: Top-Right vertex -->
              {isLastCol && (
                <span class="absolute top-0 right-0 translate-x-1/2 -translate-y-1/2 w-[12px] h-[12px] rounded-full border-[2px] border-[#C8CAD4] bg-white z-20 pointer-events-none"></span>
              )}

              <!-- Circular Node: Bottom-Left vertex -->
              {isLastRow && (
                <span class="absolute bottom-0 left-0 -translate-x-1/2 translate-y-1/2 w-[12px] h-[12px] rounded-full border-[2px] border-[#C8CAD4] bg-white z-20 pointer-events-none"></span>
              )}

              <!-- Circular Node: Bottom-Right vertex -->
              {isLastRow && isLastCol && (
                <span class="absolute bottom-0 right-0 translate-x-1/2 translate-y-1/2 w-[12px] h-[12px] rounded-full border-[2px] border-[#C8CAD4] bg-white z-20 pointer-events-none"></span>
              )}

              <!-- Logo Content -->
              <div class="relative w-full h-full flex items-center justify-center overflow-hidden">
                <div
                  class="partner-logo-target relative flex items-center justify-center w-[70%] h-[70%] max-w-[78%] max-h-[65%] cursor-pointer group/logo"
                  data-partner-target
                >
                  <img
                    data-layer="a"
                    src={initialPartner.logo}
                    alt={initialPartner.name}
                    loading="eager"
                    class="partner-logo-layer absolute max-h-full max-w-full object-contain pointer-events-none transition-transform duration-200 group-hover/logo:scale-105"
                  />
                  <img
                    data-layer="b"
                    src=""
                    alt=""
                    loading="eager"
                    class="partner-logo-layer absolute max-h-full max-w-full object-contain opacity-0 pointer-events-none transition-transform duration-200 group-hover/logo:scale-105"
                    style="transform: scale(0.85);"
                  />
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Floating Tooltip for Partner Name (Appears when logo itself is hovered) -->
    <div
      id="partner-tooltip"
      role="tooltip"
      class="pointer-events-none fixed z-50 px-3.5 py-1.5 rounded-lg bg-[#1E2029] text-white text-xs sm:text-[13px] font-sans font-medium tracking-wide shadow-[0_8px_24px_rgba(0,0,0,0.35)] border border-[#383B47] transition-[opacity,transform] duration-200 ease-out opacity-0 scale-95 select-none"
      style="transform: translate(-50%, -100%); top: -9999px; left: -9999px;"
    >
      <span id="partner-tooltip-text"></span>
      <span
        id="partner-tooltip-arrow"
        class="absolute top-full left-1/2 -translate-x-1/2 -mt-[1px] border-4 border-transparent border-t-[#1E2029]"
      ></span>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- BOTTOM HALF (Mobile) / SECTION B (Desktop) -->
  <!-- ========================================== -->
  <div id="history-growth-section" class="relative w-full h-1/2 md:h-auto md:flex-1 flex flex-col justify-between md:justify-end pb-0 overflow-hidden select-none">
    
    <!-- Section Title (centered with matched top/bottom margins) -->
    <div class="w-full text-center px-4 my-3 sm:my-4 md:my-5 flex-shrink-0">
      <h2 class="relative z-10 inline-block text-xl sm:text-2xl md:text-3xl lg:text-4xl font-normal tracking-[0.015em] text-gray-900 font-sans leading-tight">
        Our Persistent Growth
      </h2>
    </div>
    
    <!-- Floating Scattered Images (Contained strictly in bottom half on mobile; original positions on desktop) -->
    <div class="history-floating-images pointer-events-none select-none absolute inset-0 z-0 overflow-hidden">
      <!-- Floating 1: Left above 2025 -->
      <div class="absolute left-[4%] md:left-[6%] top-[34%] md:top-[28%] w-20 h-14 sm:w-32 sm:h-20 md:w-44 md:h-28 bg-gray-200 border border-gray-300 shadow-[5px_5px_0px_rgba(203,213,225,0.9)] opacity-50 filter grayscale">
        <img src={staticFloatingImgs[0].url} alt={staticFloatingImgs[0].alt} class="w-full h-full object-cover" />
      </div>

      <!-- Floating 2: Top-left corner on mobile (away from title); centered top-left on desktop -->
      <div class="absolute left-[3%] md:left-[26%] top-[4%] md:top-[4%] w-8 h-8 sm:w-11 sm:h-11 md:w-14 md:h-14 bg-gray-200 border border-gray-300 shadow-[4px_4px_0px_rgba(203,213,225,0.9)] opacity-80 filter grayscale">
        <img src={staticFloatingImgs[1].url} alt={staticFloatingImgs[1].alt} class="w-full h-full object-cover" />
      </div>

      <!-- Floating 3: Top-right corner on mobile (away from title); right of title on desktop -->
      <div class="absolute right-[3%] md:right-auto md:left-[67%] top-[4%] md:top-[6%] w-22 h-14 sm:w-36 sm:h-22 md:w-48 md:h-30 bg-gray-200 border border-gray-300 shadow-[5px_5px_0px_rgba(203,213,225,0.9)] opacity-50 filter grayscale">
        <img src={staticFloatingImgs[2].url} alt={staticFloatingImgs[2].alt} class="w-full h-full object-cover" />
      </div>

      <!-- Floating 4: Far Right Top/Mid -->
      <div class="absolute right-[4%] md:right-[5%] top-[32%] md:top-[26%] w-8 h-8 sm:w-11 sm:h-11 md:w-14 md:h-14 bg-gray-200 border border-gray-300 shadow-[4px_4px_0px_rgba(203,213,225,0.9)] opacity-100 filter grayscale">
        <img src={staticFloatingImgs[2].url} alt={staticFloatingImgs[2].alt} class="w-full h-full object-cover" />
      </div>

      <!-- Floating 5: Bottom Right under description text -->
      <div class="absolute left-[82%] md:left-[86%] bottom-[12px] md:bottom-[20px] w-8 h-8 sm:w-11 sm:h-11 md:w-14 md:h-14 bg-gray-200 border border-gray-300 shadow-[4px_4px_0px_rgba(203,213,225,0.9)] opacity-80 filter grayscale">
        <img src={staticFloatingImgs[4].url} alt={staticFloatingImgs[4].alt} class="hidden md:block w-full h-full object-cover" />
        <img src={staticFloatingImgs[3].url} alt={staticFloatingImgs[3].alt} class="md:hidden w-full h-full object-cover" />
      </div>
    </div>
    

    <!-- ======================================================== -->
    <!-- MOBILE VIEW (md:hidden): Vertical Flipped Timeline (Left Half) + Milestone Info (Right Half) -->
    <!-- ======================================================== -->
    <div class="mobile-history-layout relative z-10 w-full flex-1 min-h-0 flex flex-row items-center overflow-hidden md:hidden pb-1">
      
      <!-- LEFT HALF (w-1/2): Vertical Sliding Timeline (Ruler Flipped Vertically) -->
      <div
        id="mobile-history-timeline-track"
        class="relative w-1/2 h-full select-none overflow-hidden cursor-grab"
        title="Geser atau klik tahun untuk navigasi milestone"
        style="mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); touch-action: none;"
      >
        <!-- Continuous vertical axis line along the left edge -->
        <div class="absolute top-0 bottom-0 left-0 w-[2.5px] bg-[#C8CAD4] pointer-events-none z-10"></div>

        <!-- The sliding ruler container (moves vertically along Y) -->
        <div
          id="mobile-timeline-slider"
          class="absolute top-0 left-0 right-0 will-change-transform"
          style="transform: translate3d(0, 0px, 0);"
        >
          <!-- 1. Ruler Ticks Container (Intermediate ticks extending horizontally from left-0) -->
          <div id="mobile-timeline-ticks" class="absolute inset-0 pointer-events-none">
            {resolvedMilestones.slice(0, -1).map((_, i) => (
              <>
                <span
                  data-mobile-milestone-step={i}
                  data-mobile-tick-sub="1"
                  class="mobile-timeline-tick absolute left-0 h-[2px] w-5 sm:w-7 bg-[#C8CAD4] -translate-y-1/2"
                ></span>
                <span
                  data-mobile-milestone-step={i}
                  data-mobile-tick-sub="2"
                  class="mobile-timeline-tick absolute left-0 h-[2px] w-5 sm:w-7 bg-[#C8CAD4] -translate-y-1/2"
                ></span>
                <span
                  data-mobile-milestone-step={i}
                  data-mobile-tick-sub="3"
                  class="mobile-timeline-tick absolute left-0 h-[2px] w-5 sm:w-7 bg-[#C8CAD4] -translate-y-1/2"
                ></span>
              </>
            ))}
          </div>

          <!-- 2. Dynamic Milestones: Horizontal stem, circular node, and year number -->
          {resolvedMilestones.map((milestone, idx) => {
            const isActive = idx === activeIndex;

            return (
              <button
                type="button"
                aria-current={isActive ? 'true' : undefined}
                class="mobile-milestone-btn absolute left-0 flex flex-row items-center cursor-pointer group focus:outline-none select-none z-20 py-1"
                data-index={idx}
                data-year={milestone.year}
                aria-label={`Pilih tahun ${milestone.year}`}
              >
                <!-- Horizontal Stem touching left-0 -->
                <div
                  class={`mobile-milestone-stem h-[2.5px] w-6 sm:w-8 transition-colors duration-200 ${
                    isActive ? 'bg-[#1E2029]' : 'bg-[#C8CAD4]'
                  }`}
                ></div>

                <!-- Plain circle with a transparent border. -->
                <div class="mobile-milestone-node" aria-hidden="true"></div>

                <!-- Year Number -->
                <span
                  class={`mobile-milestone-year-text ml-2 font-tech text-4xl sm:text-5xl tracking-wider leading-none select-none uppercase transition-all duration-200 ${
                    isActive ? 'text-[#1E2029]' : 'text-[#8F94A6]'
                  }`}
                >
                  {milestone.year}
                </span>
              </button>
            );
          })}
        </div>
      </div>

      <!-- RIGHT HALF (w-1/2): Description Text of Active Milestone -->
      <div class="mobile-history-description relative w-1/2 h-full flex flex-col justify-center px-3 sm:px-4 py-2 z-20 pointer-events-auto">
        <div class="max-w-[170px] sm:max-w-[200px]">
          <p
            id="mobile-milestone-desc-text"
            class="text-xs sm:text-[13px] text-gray-900 leading-[1.55] font-sans font-normal tracking-[0.015em] transition-opacity duration-200"
          >
            {initialMilestone.description}
          </p>
        </div>
      </div>

    </div>

    <!-- ======================================================== -->
    <!-- DESKTOP VIEW (hidden md:block): Original Horizontal Timeline Track -->
    <!-- ======================================================== -->
    <div
      id="history-timeline-track"
      class="relative z-10 w-full h-[170px] sm:h-[185px] md:h-[200px] lg:h-[210px] cursor-grab select-none overflow-hidden touch-pan-y hidden md:block"
      title="Geser atau klik tahun untuk navigasi milestone"
    >
      <!-- Timeline Sliding Track Viewport with right fade-out mask -->
      <div
        id="timeline-viewport"
        class="absolute inset-0 pointer-events-auto"
      >
        <!-- The sliding ruler and milestones container -->
        <div
          id="timeline-slider"
          class="absolute top-0 bottom-0 left-0 flex items-end will-change-transform"
          style="transform: translate3d(0px, 0, 0);"
        >
          <!-- 1. Ruler Ticks Container (Intermediate ticks between milestones only) -->
          <div id="timeline-ticks" class="absolute inset-0 pointer-events-none">
            <!-- Intermediate ticks between consecutive milestones (Ends at 2022, no leading ticks) -->
            {resolvedMilestones.slice(0, -1).map((_, i) => (
              <>
                <span
                  data-milestone-step={i}
                  data-tick-sub="1"
                  class="timeline-tick absolute bottom-0 w-[2.5px] h-12 sm:h-14 md:h-16 lg:h-18 bg-[#C8CAD4]"
                ></span>
                <span
                  data-milestone-step={i}
                  data-tick-sub="2"
                  class="timeline-tick absolute bottom-0 w-[2.5px] h-12 sm:h-14 md:h-16 lg:h-18 bg-[#C8CAD4]"
                ></span>
                <span
                  data-milestone-step={i}
                  data-tick-sub="3"
                  class="timeline-tick absolute bottom-0 w-[2.5px] h-12 sm:h-14 md:h-16 lg:h-18 bg-[#C8CAD4]"
                ></span>
              </>
            ))}
          </div>

          <!-- 2. Dynamic Milestones: Render each year with stem, circular node, and year number -->
          {resolvedMilestones.map((milestone, idx) => {
            const isActive = idx === activeIndex;

            return (
              <button
                type="button"
                aria-current={isActive ? 'true' : undefined}
                class="milestone-btn absolute bottom-0 flex flex-col items-center cursor-pointer group focus:outline-none select-none z-20 px-2"
                data-index={idx}
                data-year={milestone.year}
                aria-label={`Pilih tahun ${milestone.year}`}
              >
                <!-- Year Number -->
                <span
                  class={`milestone-year-text font-tech text-5xl sm:text-6xl md:text-7xl lg:text-[76px] tracking-wider leading-none mb-1.5 sm:mb-2 select-none uppercase transition-all duration-200 cursor-pointer group-hover:text-gray-900 group-hover:!opacity-100 ${
                    isActive ? 'text-[#1E2029]' : 'text-[#8F94A6]'
                  }`}
                >
                  {milestone.year}
                </span>

                <!-- A single circle; its white border overlaps the stem. -->
                <div class="milestone-node" aria-hidden="true"></div>

                <!-- Vertical Stem touching bottom-0 -->
                <div
                  class={`milestone-stem w-[2.5px] h-12 sm:h-14 md:h-16 lg:h-18 -mt-[2px] transition-colors duration-200 ${
                    isActive ? 'bg-[#1E2029]' : 'bg-[#C8CAD4]'
                  }`}
                ></div>
              </button>
            );
          })}
        </div>
      </div>

      <!-- 3. Description Text (Always sticks at the end of the timeline white fade) -->
      <div
        id="milestone-desc-container"
        class="absolute bottom-[32px] sm:bottom-[40px] md:bottom-[48px] lg:bottom-[54px] max-w-[280px] sm:max-w-sm md:max-w-md lg:max-w-sm select-none z-30 pointer-events-auto pr-3 sm:pr-4"
        style="left: calc(var(--timeline-fade-end, 66%) + 8px);"
      >
        <p
          id="milestone-desc-text"
          class="text-xs sm:text-sm md:text-[14px] text-gray-900 leading-[1.6] font-sans font-normal tracking-[0.015em] transition-opacity duration-200"
        >
          {initialMilestone.description}
        </p>
      </div>

    </div>

  </div>
</section>

<!-- Client Script: Interactive Milestone Scroll Wheel / Click / Drag Centering Handler -->
<script is:inline define:vars={{ milestonesData: resolvedMilestones, initialIdx: activeIndex }}>
  (function () {
    const milestones = milestonesData || [];
    let currentIndex = typeof initialIdx === 'number' ? initialIdx : milestones.length - 1;

    // Desktop elements
    const desktopTrack = document.getElementById('history-timeline-track');
    const desktopSlider = document.getElementById('timeline-slider');
    const desktopDescText = document.getElementById('milestone-desc-text');
    const desktopButtons = Array.from(document.querySelectorAll('.milestone-btn'));

    // Mobile elements
    const mobileTrack = document.getElementById('mobile-history-timeline-track');
    const mobileSlider = document.getElementById('mobile-timeline-slider');
    const mobileDescText = document.getElementById('mobile-milestone-desc-text');
    const mobileYearBadge = document.getElementById('mobile-milestone-year-badge');
    const mobileButtons = Array.from(document.querySelectorAll('.mobile-milestone-btn'));

    if (milestones.length === 0) return;

    // Desktop geometry
    let focalX = 0;
    let stepX = 240;
    let currentSliderX = 0;
    let isDragging = false;
    let hasDragged = false;
    let startPointerX = 0;
    let startSliderX = 0;
    let lastPointerX = 0;

    // Mobile geometry
    let mobileFocalY = 0;
    let mobileStepY = 72;
    let currentMobileSliderY = 0;
    let isMobileDragging = false;
    let hasMobileDragged = false;
    let startMobilePointerY = 0;
    let startMobileSliderY = 0;
    let lastMobilePointerY = 0;

    function calculateDimensions() {
      // 1. Desktop Horizontal Timeline
      if (desktopTrack && desktopSlider) {
        const trackWidth = desktopTrack.clientWidth || window.innerWidth;
        if (trackWidth >= 1024) {
          focalX = Math.round(trackWidth * 0.50);
          stepX = Math.round(Math.min(270, Math.max(220, trackWidth * 0.18)));
        } else if (trackWidth >= 640) {
          focalX = Math.round(trackWidth * 0.48);
          stepX = Math.round(Math.min(230, Math.max(180, trackWidth * 0.22)));
        } else {
          focalX = Math.round(trackWidth * 0.40);
          stepX = Math.round(Math.min(190, Math.max(140, trackWidth * 0.30)));
        }

        desktopButtons.forEach((btn, idx) => {
          btn.style.left = `${idx * stepX}px`;
        });

        const intermediateTicks = desktopSlider.querySelectorAll('[data-milestone-step]');
        intermediateTicks.forEach((tick) => {
          const stepIdx = parseInt(tick.getAttribute('data-milestone-step') || '0', 10);
          const subIdx = parseInt(tick.getAttribute('data-tick-sub') || '1', 10);
          tick.style.left = `${stepIdx * stepX + subIdx * 0.25 * stepX}px`;
        });
      }

      // 2. Mobile Vertical Timeline
      if (mobileTrack && mobileSlider) {
        const trackHeight = mobileTrack.clientHeight || 280;
        mobileFocalY = Math.round(trackHeight * 0.46);
        mobileStepY = Math.round(trackHeight * 0.33);

        mobileButtons.forEach((btn, idx) => {
          btn.style.top = `${idx * mobileStepY}px`;
        });

        const mobileIntermediateTicks = mobileSlider.querySelectorAll('[data-mobile-milestone-step]');
        mobileIntermediateTicks.forEach((tick) => {
          const stepIdx = parseInt(tick.getAttribute('data-mobile-milestone-step') || '0', 10);
          const subIdx = parseInt(tick.getAttribute('data-mobile-tick-sub') || '1', 10);
          tick.style.top = `${stepIdx * mobileStepY + subIdx * 0.25 * mobileStepY}px`;
        });
      }
    }

    function setDesktopSliderPosition(x, animate = true) {
      currentSliderX = x;
      if (!desktopSlider) return;
      if (animate) {
        desktopSlider.style.transition = 'transform 450ms cubic-bezier(0.16, 1, 0.3, 1)';
      } else {
        desktopSlider.style.transition = 'none';
      }
      desktopSlider.style.transform = `translate3d(${x}px, 0, 0)`;
    }

    function setMobileSliderPosition(y, animate = true) {
      currentMobileSliderY = y;
      if (!mobileSlider) return;
      if (animate) {
        mobileSlider.style.transition = 'transform 450ms cubic-bezier(0.16, 1, 0.3, 1)';
      } else {
        mobileSlider.style.transition = 'none';
      }
      mobileSlider.style.transform = `translate3d(0, ${y}px, 0)`;
    }

    function updateDesktopVisuals(index) {
      desktopButtons.forEach((btn, idx) => {
        const yearText = btn.querySelector('.milestone-year-text');
        const stem = btn.querySelector('.milestone-stem');
        const diff = idx - index;

        btn.style.opacity = '1';
        btn.style.transform = 'translateX(-50%)';

        if (diff === 0) {
          btn.setAttribute('aria-current', 'true');
          btn.style.pointerEvents = 'auto';
          if (yearText) {
            yearText.classList.remove('text-[#8F94A6]');
            yearText.classList.add('text-[#1E2029]');
            yearText.style.opacity = '1';
          }
          if (stem) {
            stem.classList.remove('bg-[#C8CAD4]');
            stem.classList.add('bg-[#1E2029]');
          }
        } else {
          btn.removeAttribute('aria-current');
          if (stem) {
            stem.classList.remove('bg-[#1E2029]');
            stem.classList.add('bg-[#C8CAD4]');
          }

          if (diff < 0) {
            btn.style.pointerEvents = 'auto';
            if (yearText) {
              yearText.classList.remove('text-[#1E2029]');
              yearText.classList.add('text-[#8F94A6]');
              if (diff === -1) yearText.style.opacity = '0.70';
              else if (diff === -2) yearText.style.opacity = '0.50';
              else if (diff === -3) yearText.style.opacity = '0.35';
              else yearText.style.opacity = '0.22';
            }
          } else {
            if (yearText) yearText.style.opacity = '0';
            btn.style.pointerEvents = 'auto';
          }
        }
      });
    }

    function updateMobileVisuals(index) {
      mobileButtons.forEach((btn, idx) => {
        const yearText = btn.querySelector('.mobile-milestone-year-text');
        const stem = btn.querySelector('.mobile-milestone-stem');
        const diff = idx - index;

        btn.style.opacity = '1';
        btn.style.transform = 'translateY(-50%)';

        if (diff === 0) {
          btn.setAttribute('aria-current', 'true');
          btn.style.pointerEvents = 'auto';
          if (yearText) {
            yearText.classList.remove('text-[#8F94A6]');
            yearText.classList.add('text-[#1E2029]');
            yearText.style.opacity = '1';
          }
          if (stem) {
            stem.classList.remove('bg-[#C8CAD4]');
            stem.classList.add('bg-[#1E2029]');
          }
        } else {
          btn.removeAttribute('aria-current');
          if (stem) {
            stem.classList.remove('bg-[#1E2029]');
            stem.classList.add('bg-[#C8CAD4]');
          }

          if (diff < 0) {
            btn.style.pointerEvents = 'auto';
            if (yearText) {
              yearText.classList.remove('text-[#1E2029]');
              yearText.classList.add('text-[#8F94A6]');
              if (diff === -1) yearText.style.opacity = '0.70';
              else if (diff === -2) yearText.style.opacity = '0.50';
              else if (diff === -3) yearText.style.opacity = '0.35';
              else yearText.style.opacity = '0.22';
            }
          } else {
            if (yearText) yearText.style.opacity = '0';
            btn.style.pointerEvents = 'auto';
          }
        }
      });
    }

    function goToMilestone(index, animate = true) {
      if (index < 0 || index >= milestones.length) return;
      currentIndex = index;
      const target = milestones[index];

      // 1. Desktop Update
      if (desktopSlider) {
        const targetX = focalX - currentIndex * stepX;
        setDesktopSliderPosition(targetX, animate);
        updateDesktopVisuals(index);
        if (desktopDescText) {
          desktopDescText.style.opacity = '0';
          setTimeout(() => {
            desktopDescText.textContent = target.description || '';
            desktopDescText.style.opacity = '1';
          }, 140);
        }
      }

      // 2. Mobile Update
      if (mobileSlider) {
        const targetY = mobileFocalY - currentIndex * mobileStepY;
        setMobileSliderPosition(targetY, animate);
        updateMobileVisuals(index);
        if (mobileDescText) {
          mobileDescText.style.opacity = '0';
          setTimeout(() => {
            mobileDescText.textContent = target.description || '';
            mobileDescText.style.opacity = '1';
          }, 140);
        }
        if (mobileYearBadge) {
          mobileYearBadge.textContent = String(target.year || '');
        }
      }
    }

    // Initialize layout and state
    calculateDimensions();
    goToMilestone(currentIndex, false);

    // Window resize handler
    window.addEventListener('resize', () => {
      calculateDimensions();
      if (desktopSlider) {
        setDesktopSliderPosition(focalX - currentIndex * stepX, false);
        updateDesktopVisuals(currentIndex);
      }
      if (mobileSlider) {
        setMobileSliderPosition(mobileFocalY - currentIndex * mobileStepY, false);
        updateMobileVisuals(currentIndex);
      }
    });

    // ==========================================
    // 1. Desktop Track Click Handler
    // ==========================================
    if (desktopTrack) {
      desktopTrack.addEventListener('click', (e) => {
        if (hasDragged) return;
        if (e.target && e.target.closest('#milestone-desc-text')) return;

        const trackRect = desktopTrack.getBoundingClientRect();
        const clickX = e.clientX - trackRect.left;
        const activeScreenX = currentSliderX + currentIndex * stepX;

        const clickedBtn = e.target.closest('.milestone-btn');
        if (clickedBtn) {
          const idx = parseInt(clickedBtn.getAttribute('data-index') || '0', 10);
          if (idx !== currentIndex) {
            goToMilestone(idx, true);
          }
          return;
        }

        if (clickX > activeScreenX + 35) {
          if (currentIndex < milestones.length - 1) {
            goToMilestone(currentIndex + 1, true);
          }
          return;
        }

        if (clickX < activeScreenX - 35) {
          const sliderClickX = clickX - currentSliderX;
          const targetIdx = Math.round(sliderClickX / stepX);
          if (targetIdx >= 0 && targetIdx < currentIndex) {
            goToMilestone(targetIdx, true);
          }
          return;
        }
      });
    }

    desktopButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (hasDragged) return;
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        if (idx !== currentIndex) {
          goToMilestone(idx, true);
        }
      });
    });

    // ==========================================
    // 2. Mobile Track Click Handler
    // ==========================================
    if (mobileTrack) {
      mobileTrack.addEventListener('click', (e) => {
        if (hasMobileDragged) return;

        const clickedBtn = e.target.closest('.mobile-milestone-btn');
        if (clickedBtn) {
          const idx = parseInt(clickedBtn.getAttribute('data-index') || '0', 10);
          if (idx !== currentIndex) {
            goToMilestone(idx, true);
          }
          return;
        }

        const trackRect = mobileTrack.getBoundingClientRect();
        const clickY = e.clientY - trackRect.top;
        const activeScreenY = currentMobileSliderY + currentIndex * mobileStepY;

        if (clickY > activeScreenY + 25) {
          if (currentIndex < milestones.length - 1) {
            goToMilestone(currentIndex + 1, true);
          }
          return;
        }

        if (clickY < activeScreenY - 25) {
          const sliderClickY = clickY - currentMobileSliderY;
          const targetIdx = Math.round(sliderClickY / mobileStepY);
          if (targetIdx >= 0 && targetIdx < currentIndex) {
            goToMilestone(targetIdx, true);
          }
          return;
        }
      });

      mobileTrack.addEventListener('wheel', (e) => {
        e.preventDefault();
        if (Math.abs(e.deltaY) > 15) {
          if (e.deltaY > 0) {
            if (currentIndex < milestones.length - 1) goToMilestone(currentIndex + 1, true);
          } else {
            if (currentIndex > 0) goToMilestone(currentIndex - 1, true);
          }
        }
      }, { passive: false });
    }

    mobileButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (hasMobileDragged) return;
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        if (idx !== currentIndex) {
          goToMilestone(idx, true);
        }
      });
    });

    // ==========================================
    // 3. Desktop Dragging (Horizontal)
    // ==========================================
    if (desktopTrack && desktopSlider) {
      desktopTrack.addEventListener('pointerdown', (e) => {
        if (e.target && e.target.closest('#milestone-desc-text')) return;
        isDragging = true;
        hasDragged = false;
        startPointerX = e.clientX;
        lastPointerX = e.clientX;
        startSliderX = currentSliderX;
        desktopSlider.style.transition = 'none';
      });
    }

    // ==========================================
    // 4. Mobile Dragging (Vertical)
    // ==========================================
    if (mobileTrack && mobileSlider) {
      mobileTrack.addEventListener('pointerdown', (e) => {
        isMobileDragging = true;
        hasMobileDragged = false;
        startMobilePointerY = e.clientY;
        lastMobilePointerY = e.clientY;
        startMobileSliderY = currentMobileSliderY;
        mobileSlider.style.transition = 'none';
      });
    }

    // Unified pointermove
    window.addEventListener('pointermove', (e) => {
      if (isDragging && desktopTrack) {
        lastPointerX = e.clientX;
        const deltaX = e.clientX - startPointerX;
        if (!hasDragged && Math.abs(deltaX) > 6) {
          hasDragged = true;
          desktopTrack.classList.add('cursor-grabbing');
          try {
            if (e.pointerId) desktopTrack.setPointerCapture(e.pointerId);
          } catch (_) {}
        }
        if (hasDragged) {
          const minX = focalX - (milestones.length - 1) * stepX;
          const maxX = focalX;
          let newX = startSliderX + deltaX;
          if (newX > maxX) newX = maxX + (newX - maxX) * 0.25;
          else if (newX < minX) newX = minX + (newX - minX) * 0.25;
          setDesktopSliderPosition(newX, false);
        }
      }

      if (isMobileDragging && mobileTrack) {
        lastMobilePointerY = e.clientY;
        const deltaY = e.clientY - startMobilePointerY;
        if (!hasMobileDragged && Math.abs(deltaY) > 6) {
          hasMobileDragged = true;
          mobileTrack.classList.add('cursor-grabbing');
          try {
            if (e.pointerId) mobileTrack.setPointerCapture(e.pointerId);
          } catch (_) {}
        }
        if (hasMobileDragged) {
          const minY = mobileFocalY - (milestones.length - 1) * mobileStepY;
          const maxY = mobileFocalY;
          let newY = startMobileSliderY + deltaY;
          if (newY > maxY) newY = maxY + (newY - maxY) * 0.25;
          else if (newY < minY) newY = minY + (newY - minY) * 0.25;
          setMobileSliderPosition(newY, false);
        }
      }
    });

    function finishDrag(e) {
      if (isDragging && desktopTrack) {
        isDragging = false;
        desktopTrack.classList.remove('cursor-grabbing');
        try {
          if (e && e.pointerId && desktopTrack.hasPointerCapture && desktopTrack.hasPointerCapture(e.pointerId)) {
            desktopTrack.releasePointerCapture(e.pointerId);
          }
        } catch (_) {}

        if (hasDragged) {
          const currentX = (e && typeof e.clientX === 'number') ? e.clientX : lastPointerX;
          const deltaX = currentX - startPointerX;
          let snappedIdx = Math.round((focalX - currentSliderX) / stepX);

          if (deltaX < -25 && snappedIdx <= currentIndex) {
            snappedIdx = Math.min(milestones.length - 1, currentIndex + 1);
          } else if (deltaX > 25 && snappedIdx >= currentIndex) {
            snappedIdx = Math.max(0, currentIndex - 1);
          }

          snappedIdx = Math.max(0, Math.min(milestones.length - 1, snappedIdx));
          goToMilestone(snappedIdx, true);

          setTimeout(() => {
            hasDragged = false;
          }, 80);
        }
      }

      if (isMobileDragging && mobileTrack) {
        isMobileDragging = false;
        mobileTrack.classList.remove('cursor-grabbing');
        try {
          if (e && e.pointerId && mobileTrack.hasPointerCapture && mobileTrack.hasPointerCapture(e.pointerId)) {
            mobileTrack.releasePointerCapture(e.pointerId);
          }
        } catch (_) {}

        if (hasMobileDragged) {
          const currentY = (e && typeof e.clientY === 'number') ? e.clientY : lastMobilePointerY;
          const deltaY = currentY - startMobilePointerY;
          let snappedIdx = Math.round((mobileFocalY - currentMobileSliderY) / mobileStepY);

          if (deltaY < -20 && snappedIdx <= currentIndex) {
            snappedIdx = Math.min(milestones.length - 1, currentIndex + 1);
          } else if (deltaY > 20 && snappedIdx >= currentIndex) {
            snappedIdx = Math.max(0, currentIndex - 1);
          }

          snappedIdx = Math.max(0, Math.min(milestones.length - 1, snappedIdx));
          goToMilestone(snappedIdx, true);

          setTimeout(() => {
            hasMobileDragged = false;
          }, 80);
        }
      }
    }

    window.addEventListener('pointerup', finishDrag);
    window.addEventListener('pointercancel', finishDrag);

    // ==========================================
    // 5. Keyboard Navigation
    // ==========================================
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        if (currentIndex < milestones.length - 1) {
          goToMilestone(currentIndex + 1, true);
        }
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        if (currentIndex > 0) {
          goToMilestone(currentIndex - 1, true);
        }
      }
    });
  })();
</script>

<!-- Client Script: Diagonal Wave Looping Animation & Partner Logo Tooltip -->
<script is:inline define:vars={{ partnersPool: uniquePartnersList }}>
  (function () {
    const gridRoots = Array.from(document.querySelectorAll('.partners-grid-root'));
    const tooltip = document.getElementById('partner-tooltip');
    const tooltipText = document.getElementById('partner-tooltip-text');
    const tooltipArrow = document.getElementById('partner-tooltip-arrow');

    if (gridRoots.length === 0 || !Array.isArray(partnersPool) || partnersPool.length < 2) return;

    // Check user preference for reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Preload all partner logo images to guarantee 0% flicker
    partnersPool.forEach((p) => {
      if (p && p.logo) {
        const img = new Image();
        img.src = p.logo;
      }
    });

    // Fill the viewport horizontally, increasing columns if the rows would reach history.
    const partnersSection = document.getElementById('history-partners-section');
    const mobileStage = document.querySelector('.mobile-partners-stage');
    function fitMobilePartnerGrids() {
      if (!partnersSection || !mobileStage || window.innerWidth >= 768) return;
      const heading = partnersSection.firstElementChild;
      const availableHeight = Math.max(1, partnersSection.clientHeight - heading.offsetHeight - 8);
      const gridWidth = mobileStage.clientWidth * 1.2;
      let columns = 6;
      let smallColumns = 10;
      while (columns < 24 && gridWidth * (2 / (columns * 1.2) + 2 / smallColumns) > availableHeight) {
        columns++;
        smallColumns = Math.ceil(columns * 5 / 3);
      }
      mobileStage.querySelectorAll('.mobile-partner-grid').forEach((grid) => {
        const count = grid.classList.contains('is-small') ? smallColumns : columns;
        grid.style.setProperty('--partner-columns', count);
        grid.querySelectorAll('[data-partner-cell]').forEach((cell) => {
          cell.hidden = Number(cell.getAttribute('data-partner-col')) >= count;
        });
      });
    }
    fitMobilePartnerGrids();
    if (partnersSection) new ResizeObserver(fitMobilePartnerGrids).observe(partnersSection);

    const cellActiveLayer = new Map();
    let isHovered = false;

    // ========================================================
    // Tooltip Engine (Targeted strictly to the logo element)
    // ========================================================
    function showTooltip(target) {
      if (!tooltip || !tooltipText) return;

      const cell = target.closest('[data-partner-cell]');
      if (!cell) return;

      const activeLayerKey = cellActiveLayer.get(cell) || 'a';
      const activeImg = cell.querySelector(`[data-layer="${activeLayerKey}"]`);
      const name = activeImg ? activeImg.getAttribute('alt') || '' : '';
      if (!name) return;

      tooltipText.textContent = name;

      const rect = target.getBoundingClientRect();
      const tooltipWidth = tooltip.offsetWidth || 140;
      const tooltipHeight = tooltip.offsetHeight || 32;

      // Center horizontally over the logo
      let left = rect.left + rect.width / 2;
      // Position above the logo by default
      let top = rect.top - 8;
      let isAbove = true;

      // If too close to viewport top, show below the logo instead
      if (rect.top < tooltipHeight + 16) {
        top = rect.bottom + 8;
        isAbove = false;
      }

      // Prevent horizontal overflow past viewport edges
      const minLeft = tooltipWidth / 2 + 12;
      const maxLeft = window.innerWidth - tooltipWidth / 2 - 12;
      left = Math.max(minLeft, Math.min(left, maxLeft));

      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${top}px`;

      if (tooltipArrow) {
        if (isAbove) {
          tooltip.style.transform = 'translate(-50%, -100%)';
          tooltipArrow.className = 'absolute top-full left-1/2 -translate-x-1/2 -mt-[1px] border-4 border-transparent border-t-[#1E2029]';
        } else {
          tooltip.style.transform = 'translate(-50%, 0)';
          tooltipArrow.className = 'absolute bottom-full left-1/2 -translate-x-1/2 -mb-[1px] border-4 border-transparent border-b-[#1E2029]';
        }
      }

      tooltip.classList.remove('opacity-0', 'scale-95');
      tooltip.classList.add('opacity-100', 'scale-100');
    }

    function hideTooltip() {
      if (!tooltip) return;
      tooltip.classList.remove('opacity-100', 'scale-100');
      tooltip.classList.add('opacity-0', 'scale-95');
    }

    // Attach hover listeners to all partner targets across both mobile & desktop grids
    const allTargets = Array.from(document.querySelectorAll('[data-partner-target]'));
    allTargets.forEach((target) => {
      target.addEventListener('mouseenter', () => {
        isHovered = true;
        showTooltip(target);
      });

      target.addEventListener('mouseleave', () => {
        isHovered = false;
        hideTooltip();
      });
    });

    window.addEventListener('scroll', hideTooltip, { passive: true });
    window.addEventListener('resize', hideTooltip, { passive: true });

    // ========================================================
    // Looping Diagonal Wave Animation Engine per Grid Root
    // ========================================================
    function initGridWave(gridRoot) {
      const cells = Array.from(gridRoot.querySelectorAll('[data-partner-cell]'));
      if (cells.length === 0) return;

      const setsMap = new Map();
      let totalSets = 0;
      function refreshDiagonalSets() {
        setsMap.clear();
        cells.filter((cell) => !cell.hidden).forEach((cell) => {
          const diagSet = Number(cell.getAttribute('data-diag-set') || 0);
          if (!setsMap.has(diagSet)) setsMap.set(diagSet, []);
          setsMap.get(diagSet).push(cell);
          if (!cellActiveLayer.has(cell)) cellActiveLayer.set(cell, 'a');
        });
        totalSets = setsMap.size;
      }
      refreshDiagonalSets();

      const staggerDelay = 140; // ms delay between consecutive diagonal sets (wave ripple speed)
      const shrinkDuration = 320; // ms for shrink animation
      const fadeInDuration = 400; // ms for fade-in animation
      const waveRestInterval = 2800; // ms pause between complete wave loops

      let currentWave = Number(gridRoot.getAttribute('data-partner-offset') || 0);
      let isWaveActive = false;
      let isVisible = true;
      let nextWaveTimeout = null;
      let stepTimer = null;
      let currentSetIndex = 0;

      function runWave() {
        if (!isVisible || isHovered) {
          scheduleNextWave(600);
          return;
        }

        refreshDiagonalSets();
        isWaveActive = true;
        currentWave++;
        currentSetIndex = 0;
        stepNextSet();
      }

      function stepNextSet() {
        if (stepTimer) clearTimeout(stepTimer);

        if (isHovered) {
          stepTimer = setTimeout(stepNextSet, 120);
          return;
        }

        if (currentSetIndex < totalSets) {
          const d = currentSetIndex;
          animateDiagonalSet(d);
          currentSetIndex++;
          stepTimer = setTimeout(stepNextSet, staggerDelay);
        } else {
          setTimeout(() => {
            isWaveActive = false;
            scheduleNextWave(waveRestInterval);
          }, shrinkDuration + fadeInDuration);
        }
      }

      function animateDiagonalSet(d) {
        const setCells = setsMap.get(d) || [];
        const nextPartnerIndex = (d + currentWave) % partnersPool.length;
        const nextPartner = partnersPool[nextPartnerIndex];

        setCells.forEach((cell) => {
          const activeLayerKey = cellActiveLayer.get(cell) || 'a';
          const nextLayerKey = activeLayerKey === 'a' ? 'b' : 'a';

          const activeImg = cell.querySelector(`[data-layer="${activeLayerKey}"]`);
          const nextImg = cell.querySelector(`[data-layer="${nextLayerKey}"]`);

          if (!activeImg || !nextImg) return;

          // 1. Prepare nextImg with the new partner details while still hidden
          nextImg.src = nextPartner.logo;
          nextImg.alt = nextPartner.name;
          nextImg.style.transition = 'none';
          nextImg.style.transform = prefersReducedMotion ? 'scale(1)' : 'scale(0.85)';
          nextImg.style.opacity = '0';

          // 2. Shrink currently active image
          if (prefersReducedMotion) {
            activeImg.style.transition = `opacity ${shrinkDuration}ms ease-in`;
            activeImg.style.opacity = '0';
          } else {
            activeImg.style.transition = `transform ${shrinkDuration}ms cubic-bezier(0.4, 0, 0.2, 1), opacity ${Math.round(shrinkDuration * 0.85)}ms ease-in`;
            activeImg.style.transform = 'scale(0)';
            activeImg.style.opacity = '0';
          }

          // 3. Fade in replacing image as the previous image shrinks out
          const fadeInDelay = Math.round(shrinkDuration * 0.8);
          setTimeout(() => {
            if (!isVisible) return;
            void nextImg.offsetWidth; // Force reflow to commit prep styles

            if (prefersReducedMotion) {
              nextImg.style.transition = `opacity ${fadeInDuration}ms ease-out`;
              nextImg.style.opacity = '1';
            } else {
              nextImg.style.transition = `transform ${fadeInDuration}ms cubic-bezier(0.16, 1, 0.3, 1), opacity ${fadeInDuration}ms ease-out`;
              nextImg.style.transform = 'scale(1)';
              nextImg.style.opacity = '1';
            }

            // 4. Update the active layer reference for this cell
            cellActiveLayer.set(cell, nextLayerKey);

            // 5. Clean up old active image once fade-in finishes
            setTimeout(() => {
              activeImg.style.transition = 'none';
              activeImg.style.transform = 'scale(0.85)';
              activeImg.style.opacity = '0';
            }, fadeInDuration);
          }, fadeInDelay);
        });
      }

      function scheduleNextWave(delayMs) {
        if (nextWaveTimeout) clearTimeout(nextWaveTimeout);
        nextWaveTimeout = setTimeout(() => {
          runWave();
        }, delayMs);
      }

      // Initial start after 2.2 seconds
      scheduleNextWave(2200);

      // Viewport intersection observer to save CPU/battery when not visible
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isVisible = entry.isIntersecting && document.visibilityState === 'visible';
            if (isVisible && !isWaveActive && !nextWaveTimeout) {
              scheduleNextWave(1000);
            }
          });
        },
        { threshold: 0.05 }
      );
      observer.observe(gridRoot);

      document.addEventListener('visibilitychange', () => {
        isVisible = document.visibilityState === 'visible';
        if (isVisible && !isWaveActive && !nextWaveTimeout) {
          scheduleNextWave(1000);
        }
      });
    }

    gridRoots.forEach((gridRoot) => initGridWave(gridRoot));
  })();
</script>

